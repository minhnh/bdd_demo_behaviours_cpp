ns bml = "https://secorolab.github.io/models/sim-basic-motion-loop-rne/fsm/"

evt loop (ns=bml) sim_basic_motion_loop_rne_events {
    evt E_STEP,
    evt E_HOME_SETTLED,
    evt E_PRE_TOUCH_REACHED,
    evt E_CONTACT,
    evt E_FORWARD_DONE,
    evt E_GRIPPER_CLOSED,
    evt E_ARC_COMPLETE,
    evt E_GRIPPER_OPENED
}

fsm (ns=bml) sim_basic_motion_loop_rne_fsm {
    description: "Hold, move to a fixed pre-touch pose, descend, slide, grasp, trace an arc, release, and finish."

    states {
        S_START,
        S_HOME,
        S_PRE_TOUCH,
        S_TOUCHDOWN,
        S_FORWARD,
        S_GRIPPER_CLOSE,
        S_ARC,
        S_GRIPPER_OPEN,
        S_DONE
    }

    evt loop: <sim_basic_motion_loop_rne_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME          { from: <S_START>,         to: <S_HOME> },
        T_HOME_PRE_TOUCH      { from: <S_HOME>,          to: <S_PRE_TOUCH> },
        T_PRE_TOUCH_TOUCHDOWN { from: <S_PRE_TOUCH>,     to: <S_TOUCHDOWN> },
        T_TOUCHDOWN_FORWARD   { from: <S_TOUCHDOWN>,     to: <S_FORWARD> },
        T_FORWARD_CLOSE       { from: <S_FORWARD>,       to: <S_GRIPPER_CLOSE> },
        T_CLOSE_ARC           { from: <S_GRIPPER_CLOSE>, to: <S_ARC> },
        T_ARC_OPEN            { from: <S_ARC>,           to: <S_GRIPPER_OPEN> },
        T_OPEN_DONE           { from: <S_GRIPPER_OPEN>,  to: <S_DONE> }
    }

    reactions {
        R_STEP_START       { when: <sim_basic_motion_loop_rne_events.E_STEP>,              do: <T_START_HOME> },
        R_HOME_SETTLED     { when: <sim_basic_motion_loop_rne_events.E_HOME_SETTLED>,      do: <T_HOME_PRE_TOUCH> },
        R_PRE_TOUCH_REACHED { when: <sim_basic_motion_loop_rne_events.E_PRE_TOUCH_REACHED>, do: <T_PRE_TOUCH_TOUCHDOWN> },
        R_CONTACT          { when: <sim_basic_motion_loop_rne_events.E_CONTACT>,           do: <T_TOUCHDOWN_FORWARD> },
        R_FORWARD_DONE     { when: <sim_basic_motion_loop_rne_events.E_FORWARD_DONE>,      do: <T_FORWARD_CLOSE> },
        R_GRIPPER_CLOSED   { when: <sim_basic_motion_loop_rne_events.E_GRIPPER_CLOSED>,    do: <T_CLOSE_ARC> },
        R_ARC_COMPLETE     { when: <sim_basic_motion_loop_rne_events.E_ARC_COMPLETE>,      do: <T_ARC_OPEN> },
        R_GRIPPER_OPENED   { when: <sim_basic_motion_loop_rne_events.E_GRIPPER_OPENED>,    do: <T_OPEN_DONE> }
    }
}
