ns bml_env = "https://secorolab.github.io/models/sim-basic-motion-loop-rne/environment/"
ns bml_agn = "https://secorolab.github.io/models/sim-basic-motion-loop-rne/agents/"
ns bml_scene = "https://secorolab.github.io/models/sim-basic-motion-loop-rne/scene/"

obj set (ns=bml_env) workspace_objects {
    object table
}

ws set (ns=bml_env) workspaces {
    workspace table_ws
}

agn set (ns=bml_agn) agents {
    agent arm1,
    agent gripper1
}

comp (ns=bml_scene) table_workspace of ws <workspaces.table_ws> {
    obj <workspace_objects.table>
}

scene (ns=bml_scene) sim_basic_motion_loop_scene {
    ws comp <table_workspace>
    agn set <agents>
}
