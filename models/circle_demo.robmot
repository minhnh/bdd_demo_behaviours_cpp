// Demo: end-effector traces a Circle trajectory in the robot-base frame.
//
// Uses the same Kinova/MuJoCo environment as pick_place.robmot. The circle's
// center, plane-normal, and orientation are all derived from a snapshot of the
// initial EE pose (so the EE rotates around its starting position, in a plane
// whose normal is the unit-length starting position vector). The follow-pos
// constraint drives the EE to track the trajectory's position component while
// the orientation is held fixed at the snapshot.

ns app = "https://secorolab.github.io/models/circle-demo/"

ENVIRONMENT (ns=app) circle-env {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset {
            model: KinovaGen3,
            xml: "src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml"
        },
        gripper-mjcf: AttachmentAsset {
            xml: "src/mj_kdl_wrapper/third_party/menagerie/robotiq_2f85/2f85.xml"
        },
        table-mjcf: SceneObject {
            xml: "src/mj_kdl_wrapper/src/examples/assets/table.xml"
        }
    },
    ASSEMBLY {
        Object table using <table-mjcf> {
            position: { z: 0.72 m },
            orientation: {}
        },
        Robot robot using <kinova-mjcf> {
            attach-to: <table>.site(table_top),
            position: {},
            orientation: {},
            chain: { root: base_link, end: g_pinch }
        },
        Attachment gripper using <gripper-mjcf> {
            attach-to: <robot>.site(pinch_site),
            prefix: g_,
            tcp-site: g_pinch,
            actuator: g_fingers_actuator
        }
    }
}

CONTEXT (ns=app) shared {
    world: World {
        gravity:      Gravity,
        pose-ee-base: Pose { of: g_pinch, wrt: base_link, as-seen-by: base_link }
    },
    spec: Spec {
        gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
    }
}

MOTION_SPEC (ns=app) m_circle {
    MOVE: "EE traces a circle around its starting position"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            alpha:        TrajectoryProgress,
            radius:       LinearDistance = 0.10 m,
            center-pos:   Position = Snapshot of <shared.world.pose-ee-base>.position,
            plane-normal: Direction { as-seen-by: base_link } { x = 0.0, y = 0.0, z = 1.0 m },
            start-pose:   Pose = Snapshot of <shared.world.pose-ee-base>,
            traj: Trajectory = Circle {
                center:       <spec.center-pos>,
                radius:       <spec.radius>,
                plane-normal: <spec.plane-normal>,
                orientation:  <spec.start-pose>,
                alpha:        <spec.alpha>
            }
        }
    }

    WHEN {}

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.traj>.position,
        hold-ori:   keeping <shared.world.pose-ee-base>.orientation equal to <spec.start-pose>.orientation
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler-circle {
    CONTEXT {
        <shared.world>,
        <shared.spec>
    }

    MOTION: <m_circle>
    CONTROL_MODE: JointTorque

    CONTROLLERS {
        ctrl-follow-pos: PID { constraint: <m_circle.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-hold-ori:   PID { constraint: <m_circle.hold-ori>,   Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        arm-solver: Solver {
            robot:     <circle-env.robot>,
            algorithm: ACHD,
            root:      <circle-env.robot.chain.root>,
            end:       <circle-env.robot.chain.end>,
            gravity:   <shared.world.gravity> equal to <shared.spec.gravity-vec>
        }
    }
}
