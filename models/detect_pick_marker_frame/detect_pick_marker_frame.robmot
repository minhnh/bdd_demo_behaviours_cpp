import "detect_pick_marker_frame.fsm"
import "detect_pick_marker_frame.scenex"
ns app = "https://secorolab.github.io/models/detect-pick-marker-frame/"
ns dp = "https://secorolab.github.io/models/detect-pick-marker-frame/fsm/"

exec-context (ns=app) detect-pick-marker-frame-exec {
    runs-scene: <marker_frame_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link>,
            as-seen-by: <kinova.base_link>
        }
    },
    spec {
        linear-distance satisfied-band = 0.01 m,
        angle satisfied-band-rot       = 0.01 rad
    }
}

tolerances {
    linear-distance:  0.01 m,
    angular-distance: 0.01 rad,
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold the TCP at the startup home pose"

    context {
        spec {
            pose home-pose = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <spec.home-pose>.position within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.home-pose>.orientation within <shared.spec.satisfied-band-rot>
    }

    until {}
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    monitors {
        mon-home-holding: monitor <home.hold-position> {
            satisfied for 0.1 s { trigger: event <dp.E_HOLDING> },
        }
    }

    controllers {
        pid ctrl-hold-position    { constraint: <home.hold-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-hold-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 }
    }

    solvers {
        arm-solver: serial-chain {
            agent:     <pickplace_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        }
    }
}
