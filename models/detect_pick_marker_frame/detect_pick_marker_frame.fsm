ns dp = "https://secorolab.github.io/models/detect-pick-marker-frame/fsm/"

evt loop (ns=dp) detect_pick_marker_frame_fsm_events {
    evt E_STEP,
    evt E_GOAL,
    evt E_GRIPPER_READY,
    evt E_PICK_READY,
    evt E_GRASP_READY,
    evt E_LIFT_READY,
    evt E_PLACE_ABOVE_READY,
    evt E_PLACE_READY,
    evt E_OPEN_READY,
    evt E_RETREAT_READY,
    evt E_RETREAT_SETTLED,
    evt E_GRASP_LOST_LIFT,
    evt E_GRASP_LOST_PLACE_ABOVE,
    evt E_GRASP_LOST_PLACE,
    evt E_RECOVER
}

fsm (ns=dp) detect_pick_marker_frame_fsm {
    description: "Single-arm pick&place over continuously perceived object poses: the cube pose is a subscribed world quantity, so a goal goes straight from S_HOME to picking. Grasp-loss during transport (lift/place_above/place) routes to S_RECOVER, which captures and holds the current pose."

    states {
        S_START,
        S_HOME,
        S_PICK_ABOVE,
        S_PICK,
        S_GRASP,
        S_LIFT,
        S_PLACE_ABOVE,
        S_PLACE,
        S_OPEN,
        S_RETREAT,
        S_DONE,
        S_RECOVER
    }

    evt loop: <detect_pick_marker_frame_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME          { from: <S_START>,       to: <S_HOME> },
        T_HOME_PICK_ABOVE     { from: <S_HOME>,        to: <S_PICK_ABOVE> },
        T_HOME_HOLD           { from: <S_HOME>,        to: <S_HOME> },
        T_PICK_ABOVE_PICK     { from: <S_PICK_ABOVE>,  to: <S_PICK> },
        T_PICK_GRASP          { from: <S_PICK>,        to: <S_GRASP> },
        T_GRASP_LIFT          { from: <S_GRASP>,       to: <S_LIFT> },
        T_LIFT_PLACE_ABOVE    { from: <S_LIFT>,        to: <S_PLACE_ABOVE> },
        T_PLACE_ABOVE_PLACE   { from: <S_PLACE_ABOVE>, to: <S_PLACE> },
        T_PLACE_OPEN          { from: <S_PLACE>,       to: <S_OPEN> },
        T_OPEN_RETREAT        { from: <S_OPEN>,        to: <S_RETREAT> },
        T_RETREAT_DONE        { from: <S_RETREAT>,     to: <S_DONE> },
        T_LIFT_RECOVER        { from: <S_LIFT>,        to: <S_RECOVER> },
        T_PLACE_ABOVE_RECOVER { from: <S_PLACE_ABOVE>, to: <S_RECOVER> },
        T_PLACE_RECOVER       { from: <S_PLACE>,       to: <S_RECOVER> },
        T_RECOVER_HOLD        { from: <S_RECOVER>,     to: <S_RECOVER> }
    }

    reactions {
        R_STEP_START { when: <detect_pick_marker_frame_fsm_events.E_STEP>, do: <T_START_HOME> },
        R_GOAL { when: <detect_pick_marker_frame_fsm_events.E_GOAL>, do: <T_HOME_PICK_ABOVE> },
        R_GRIPPER_READY { when: <detect_pick_marker_frame_fsm_events.E_GRIPPER_READY>, do: <T_HOME_HOLD> },
        R_PICK_READY { when: <detect_pick_marker_frame_fsm_events.E_PICK_READY>, do: <T_PICK_ABOVE_PICK> },
        R_GRASP_READY { when: <detect_pick_marker_frame_fsm_events.E_GRASP_READY>, do: <T_PICK_GRASP> },
        R_LIFT_READY { when: <detect_pick_marker_frame_fsm_events.E_LIFT_READY>, do: <T_GRASP_LIFT> },
        R_PLACE_ABOVE_READY { when: <detect_pick_marker_frame_fsm_events.E_PLACE_ABOVE_READY>, do: <T_LIFT_PLACE_ABOVE> },
        R_PLACE_READY { when: <detect_pick_marker_frame_fsm_events.E_PLACE_READY>, do: <T_PLACE_ABOVE_PLACE> },
        R_OPEN_READY { when: <detect_pick_marker_frame_fsm_events.E_OPEN_READY>, do: <T_PLACE_OPEN> },
        R_RETREAT_READY { when: <detect_pick_marker_frame_fsm_events.E_RETREAT_READY>, do: <T_OPEN_RETREAT> },
        R_RETREAT_SETTLED { when: <detect_pick_marker_frame_fsm_events.E_RETREAT_SETTLED>, do: <T_RETREAT_DONE> },
        R_LIFT_GRASP_LOST { when: <detect_pick_marker_frame_fsm_events.E_GRASP_LOST_LIFT>, do: <T_LIFT_RECOVER> },
        R_PLACE_ABOVE_GRASP_LOST { when: <detect_pick_marker_frame_fsm_events.E_GRASP_LOST_PLACE_ABOVE>, do: <T_PLACE_ABOVE_RECOVER> },
        R_PLACE_GRASP_LOST { when: <detect_pick_marker_frame_fsm_events.E_GRASP_LOST_PLACE>, do: <T_PLACE_RECOVER> },
        R_RECOVER_HOLD { when: <detect_pick_marker_frame_fsm_events.E_RECOVER>, do: <T_RECOVER_HOLD> }
    }
}
