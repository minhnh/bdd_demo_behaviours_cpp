ns dp = "https://secorolab.github.io/models/detect-pick-marker-frame/fsm/"

evt loop (ns=dp) detect_pick_marker_frame_fsm_events {
    evt E_STEP,
    evt E_HOLDING
}

fsm (ns=dp) detect_pick_marker_frame_fsm {
    description: "Hold the arm at its startup pose. Nothing leaves S_HOME, so S_DONE is never reached and the scene stays up until the viewer is closed."

    states {
        S_START,
        S_HOME,
        S_DONE
    }

    evt loop: <detect_pick_marker_frame_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME { from: <S_START>, to: <S_HOME> },
        T_HOME_HOLD  { from: <S_HOME>,  to: <S_HOME> }
    }

    reactions {
        R_STEP_START { when: <detect_pick_marker_frame_fsm_events.E_STEP>, do: <T_START_HOME> },
        R_HOLDING    { when: <detect_pick_marker_frame_fsm_events.E_HOLDING>, do: <T_HOME_HOLD> }
    }
}
