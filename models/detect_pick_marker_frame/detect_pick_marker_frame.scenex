import "detect_pick_marker_frame.scene"
import "../robots/kinova_gen3_7dof.ktree"
import "../robots/robotiq_2f85.ktree"

ns dpm_mjc = "https://secorolab.github.io/models/scenes/detect-pick-marker-frame-mjc/"

ktree inst (ns=dpm_mjc) kinova of <kinova_tree>
ktree inst (ns=dpm_mjc) gripper of <gripper_tree>

ktree (ns=dpm_mjc) ft_tree {
    root: <wrist_ft_body.wrist_ft_body_origin>
    body wrist_ft_body {
        frame wrist_ft_body_origin { }
        // The sensor reads at the body it is: ft_sensor.xml puts the site at its origin.
        frame wrist_ft_site {
            pose wrist_ft_site_in_wrist_ft_body {
                wrt: <wrist_ft_body.wrist_ft_body_origin>
                xyz: (0.0, 0.0, 0.0) m
                orientation: euler { angles: (0.0, 0.0, 0.0) unit: rad }
            }
        }
        // What ft_sensor.xml states for the body, carried here so the inertia does not
        // depend on where the generator is run from.
        inertia {
            frame: <wrist_ft_body_origin>
            mass: 0.01 kg
            inertia-matrix: (
                (1e-5, 0.0, 0.0),
                (0.0, 1e-5, 0.0),
                (0.0, 0.0, 1e-5)
            ) kg*m^2
        }
    }
    joints { }
}

ktree (ns=dpm_mjc) kinova_2f85 {
    root: <kinova.base_link.base_link_origin>
    tree <kinova>
    tree <ft_tree>
    tree <gripper>

    joints {
        fixed ft_on_pinch_site {
            parent: <kinova.bracelet_link.pinch_site>
            child: <ft_tree.wrist_ft_body.wrist_ft_body_origin>
        }
        fixed g_mount_on_ft {
            parent: <ft_tree.wrist_ft_body.wrist_ft_site>
            child: <gripper.g_base_mount.g_mount_interface>
        }
        serial {
            root: <kinova.base_link.base_link_origin>
            tip: <gripper.g_base.g_pinch>
        }
    }
}

ktree (ns=dpm_mjc) world_tree {
    root: <world_body.world>
    tree <kinova_2f85>

    // The world is the aruco marker on the table top, at its (+x, -y) corner as the arm sees it.
    body world_body {
        frame world { }
        // Where the table stands: the legs run 0.72 m from the top down to the ground.
        frame ground {
            pose ground_in_world {
                wrt: <world_body.world>
                xyz: (0.0, 0.0, -0.72) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
    }

    body table {
        frame table_top {
            pose table_top_in_world {
                wrt: <world_body.world>
                xyz: (-0.8, 0.6, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        // table.xml states no <inertial>: MuJoCo derives these from the top and leg geoms.
        frame table_com {
            pose table_com_in_table_top {
                wrt: <table.table_top>
                xyz: (0.0, 0.0, -0.05100416904566816) m
                orientation: quat {
                    xyzw: (0.7071067811865489, 0.0, 0.7071067811865489, 0.0)
                }
            }
        }
        // Where the arm is bolted down: the end of the table away from the marker, in from the
        // far edge, facing the marker along +x.
        frame arm_mount {
            pose arm_mount_in_table_top {
                wrt: <table.table_top>
                xyz: (-0.6, -0.2, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        inertia {
            frame: <table_com>
            mass: 84.26442414492935 kg
            inertia-matrix: (
                (32.454207471081375, 0.0, 0.0),
                (0.0, 21.92592723136972, 0.0),
                (0.0, 0.0, 12.75746156052865)
            ) kg*m^2
        }
    }

    joints {
        fixed table_on_world {
            parent: <world_body.world>
            child: <table.table_top>
        }
        fixed arm_on_table {
            parent: <table.arm_mount>
            child: <kinova.base_link.base_link_origin>
        }
    }
}

scene inst (ns=dpm_mjc) marker_frame_scene_mjc {
    scene: <marker_frame_scene>

    kgraph (ns=dpm_mjc) marker_frame_graph {
        anchor: <world_tree.world_body.world>
        tree <world_tree>
    }

    obj <ws_objects.table> {
        model table-mjc as mjcf { sys path = 'src/mj_kdl_wrapper/assets/table.xml'
            map body <world_tree.table> to "table"
        }
    }

    agn <pickplace_agents.arm1> {
        model kinova-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml'
            map tree <kinova> to "base_link"
        }

        model ft-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/ft_sensor.xml'
            map tree <ft_tree> to "wrist_ft_body"
        }

        force-torque wrist_ft {
            frame: <ft_tree.wrist_ft_body.wrist_ft_site>
            observes: force torque
            update-rate: 1000.0 Hz
        }

        camera wrist {
            frame: <kinova.bracelet_link.wrist_anchor>
            type: rgb
            resolution: (640, 480)
            fov: 41.83792730009236 deg
            update-rate: 30.0 Hz
        }
    }

    agn <pickplace_agents.gripper1> {
        model gripper-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
            map tree <gripper> to "base_mount"
        }
    }
}
