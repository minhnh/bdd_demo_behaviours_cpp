ns dpm_env = "https://secorolab.github.io/models/environments/detect-pick-marker-frame/"
ns dpm_agn = "https://secorolab.github.io/models/agents/detect-pick-marker-frame/"
ns dpm_scene = "https://secorolab.github.io/models/scenes/detect-pick-marker-frame/"

obj set (ns=dpm_env) ws_objects {
    object table
}

ws set (ns=dpm_env) pickplace_workspaces {
    workspace table_ws
}

agn set (ns=dpm_agn) pickplace_agents {
    agent arm1,
    agent gripper1
}

comp (ns=dpm_env) comp_table_pickplace of ws <pickplace_workspaces.table_ws> {
    obj <ws_objects.table>
}

scene (ns=dpm_scene) marker_frame_scene {
    ws comp <comp_table_pickplace>
    agn set <pickplace_agents>
}
