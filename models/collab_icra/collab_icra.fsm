ns collab-coord='https://secorolab.github.io/models/demos/collab/coordination/'

evt loop (ns=collab-coord) collab_demo_fsm_events {
    evt E_STEP,
    evt E_RUN_STARTED,
    evt E_LOOK_ENTERED,
    evt E_SLIDE_ENTERED,
    evt E_CLOSE_ENTERED,
    evt E_LIFT_ENTERED,
    evt E_TARE_ENTERED,
    evt E_TARE_COMPLETED,
    evt E_COMPLIANCE_ENTERED,
    evt E_OPEN_ENTERED,
    evt E_DONE_ENTERED,
    evt E_GOAL,
    evt E_HANDLE_DETECTED,
    evt E_OBJ_LOCATED,
    evt E_TABLE_TOUCHED,
    evt E_OBJ_REACHED,
    evt E_OBJ_GRASPED,
    evt E_GRASP_FAILED,
    evt E_OBJECT_LIFTED,
    evt E_INTERACTION_DETECTED,
    evt E_REACHED_PRE_PLACEMENT_HEIGHT_FROM_TRANSPORT,
    evt E_REACHED_PRE_PLACEMENT_HEIGHT_FROM_COMPLIANCE,
    evt E_REACHED_PLACEMENT_POSE,
    evt E_OBJ_RELEASED,
    // Exported events
    evt E_PICK_START,
    evt E_PICK_END,
    evt E_PLACE_START,
    evt E_PLACE_END,
    // The end state's hold is over; nothing reacts, the run leaves its loop on it.
    evt E_RUN_ENDED
}

fsm (ns=collab-coord) collab_demo_fsm {
    description: "Collaborative drawer transport: locate, touch, slide, grasp, lift, re-tare, carry compliantly, place, release."

    states {
        S_START,
        S_WAIT,
        S_LOOK,
        S_TOUCH,
        S_SLIDE,
        S_CLOSE,
        S_LIFT,
        S_TARE_AFTER_LIFT,
        S_TRANSPORT,
        S_COMPLIANCE,
        S_PLACE_DOWN,
        S_OPEN,
        S_DONE
    }

    evt loop: <collab_demo_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_WAIT { from: <S_START>, to: <S_WAIT> },
        T_WAIT_LOOK { from: <S_WAIT>,  to: <S_LOOK> },
        T_LOOK_TOUCH { from: <S_LOOK>,  to: <S_TOUCH> },
        T_TOUCH_SLIDE { from: <S_TOUCH>,  to: <S_SLIDE> },
        T_SLIDE_CLOSE { from: <S_SLIDE>,    to: <S_CLOSE> },
        T_CLOSE_LIFT { from: <S_CLOSE>,    to: <S_LIFT> },
        T_CLOSE_DONE { from: <S_CLOSE>,    to: <S_DONE> },
        T_LIFT_TARE { from: <S_LIFT>, to: <S_TARE_AFTER_LIFT> },
        T_TARE_TRANSPORT { from: <S_TARE_AFTER_LIFT>, to: <S_TRANSPORT> },
        T_TRANSPORT_COMPLIANCE { from: <S_TRANSPORT>, to: <S_COMPLIANCE> },
        T_TRANSPORT_PLACE_DOWN { from: <S_TRANSPORT>, to: <S_PLACE_DOWN> },
        T_COMPLIANCE_PLACE_DOWN { from: <S_COMPLIANCE>, to: <S_PLACE_DOWN> },
        T_PLACE_DOWN_OPEN { from: <S_PLACE_DOWN>, to: <S_OPEN> },
        T_OPEN_DONE { from: <S_OPEN>, to: <S_DONE> }
    }

    reactions {
        R_STEP_START {
            when: <collab_demo_fsm_events.E_STEP>,
            do: <T_START_WAIT>,
            fires { <collab_demo_fsm_events.E_RUN_STARTED> }
        },
        R_GOAL {
            when: <collab_demo_fsm_events.E_GOAL>,
            do: <T_WAIT_LOOK>,
            fires { <collab_demo_fsm_events.E_LOOK_ENTERED> }
        },
        R_OBJ_LOCATED {
            when: <collab_demo_fsm_events.E_OBJ_LOCATED>,
            do: <T_LOOK_TOUCH>,
            fires { <collab_demo_fsm_events.E_PICK_START> }
        },
        R_TABLE_TOUCHED {
            when: <collab_demo_fsm_events.E_TABLE_TOUCHED>,
            do: <T_TOUCH_SLIDE>,
            fires { <collab_demo_fsm_events.E_SLIDE_ENTERED> }
        },
        R_OBJ_REACHED {
            when: <collab_demo_fsm_events.E_OBJ_REACHED>,
            do: <T_SLIDE_CLOSE>,
            fires { <collab_demo_fsm_events.E_CLOSE_ENTERED> }
        },
        R_OBJ_GRASPED {
            when: <collab_demo_fsm_events.E_OBJ_GRASPED>,
            do: <T_CLOSE_LIFT>,
            fires { <collab_demo_fsm_events.E_LIFT_ENTERED> }
        },
        R_GRASP_FAILED {
            when: <collab_demo_fsm_events.E_GRASP_FAILED>,
            do: <T_CLOSE_DONE>,
            fires { <collab_demo_fsm_events.E_DONE_ENTERED> }
        },
        R_OBJECT_LIFTED {
            when: <collab_demo_fsm_events.E_OBJECT_LIFTED>,
            do: <T_LIFT_TARE>,
            fires { <collab_demo_fsm_events.E_TARE_ENTERED> }
        },
        R_TARE_COMPLETED {
            when: <collab_demo_fsm_events.E_TARE_COMPLETED>,
            do: <T_TARE_TRANSPORT>,
            fires { <collab_demo_fsm_events.E_PICK_END> }
        },
        R_INTERACTION_DETECTED {
            when: <collab_demo_fsm_events.E_INTERACTION_DETECTED>,
            do: <T_TRANSPORT_COMPLIANCE>,
            fires { <collab_demo_fsm_events.E_COMPLIANCE_ENTERED> }
        },
        R_REACHED_PRE_PLACEMENT_HEIGHT_FROM_TRANSPORT {
            when: <collab_demo_fsm_events.E_REACHED_PRE_PLACEMENT_HEIGHT_FROM_TRANSPORT>,
            do: <T_TRANSPORT_PLACE_DOWN>,
            fires { <collab_demo_fsm_events.E_PLACE_START> }
        },
        R_REACHED_PRE_PLACEMENT_HEIGHT_FROM_COMPLIANCE {
            when: <collab_demo_fsm_events.E_REACHED_PRE_PLACEMENT_HEIGHT_FROM_COMPLIANCE>,
            do: <T_COMPLIANCE_PLACE_DOWN>,
            fires { <collab_demo_fsm_events.E_PLACE_START> }
        },
        R_REACHED_PLACEMENT_POSE {
            when: <collab_demo_fsm_events.E_REACHED_PLACEMENT_POSE>,
            do: <T_PLACE_DOWN_OPEN>,
            fires { <collab_demo_fsm_events.E_PLACE_END>, <collab_demo_fsm_events.E_OPEN_ENTERED> }
        },
        R_OBJ_RELEASED {
            when: <collab_demo_fsm_events.E_OBJ_RELEASED>,
            do: <T_OPEN_DONE>,
            fires { <collab_demo_fsm_events.E_DONE_ENTERED> }
        }
    }
}
