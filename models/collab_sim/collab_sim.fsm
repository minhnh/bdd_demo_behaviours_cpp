ns collab-coord='https://secorolab.github.io/models/demos/collab/coordination/'

evt loop (ns=collab-coord) sim_demo_hold_fsm_events {
    evt E_STEP,
    evt E_GOAL,
    evt E_PICK_START,
    evt E_PICK_END,
    evt E_PLACE_START,
    evt E_PLACE_END,
    evt E_GRIPPER_CLOSED,
    evt E_GRIPPER_OPENED
}

fsm (ns=collab-coord) sim_demo_hold_fsm {
    description: "Hold the pose the arm started in while the gripper cycles. The run holds that pose in S_WAIT until a goal arrives, so the cycle starts when a scenario asks for it rather than at startup."

    states {
        S_START,
        S_WAIT,
        S_CLOSE,
        S_OPEN,
        S_DONE
    }

    evt loop: <sim_demo_hold_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_WAIT  { from: <S_START>, to: <S_WAIT> },
        T_WAIT_CLOSE  { from: <S_WAIT>,  to: <S_CLOSE> },
        T_CLOSE_OPEN  { from: <S_CLOSE>, to: <S_OPEN> },
        T_OPEN_CLOSE  { from: <S_OPEN>,  to: <S_CLOSE> }
    }

    reactions {
        R_STEP_START     { when: <sim_demo_hold_fsm_events.E_STEP>,           do: <T_START_WAIT> },
        R_GOAL           { when: <sim_demo_hold_fsm_events.E_GOAL>,           do: <T_WAIT_CLOSE> },
        R_GRIPPER_CLOSED { when: <sim_demo_hold_fsm_events.E_GRIPPER_CLOSED>, do: <T_CLOSE_OPEN> },
        R_GRIPPER_OPENED { when: <sim_demo_hold_fsm_events.E_GRIPPER_OPENED>, do: <T_OPEN_CLOSE> }
    }
}
