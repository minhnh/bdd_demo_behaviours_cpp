import "../collab/collab.fsm"
import "../collab/collab.scenex"
ns app = "https://secorolab.github.io/models/demos/collab/exec/"

exec-context (ns=app) sim-collab-exec {
    runs-scene: <collab-scene-simreal>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        pose pose-elbow-base {
            of:         <kinova.forearm_link.forearm_link_origin>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>,
            normalization: (-pi, pi) rad
        },
        // Not controlled: recorded, so the run says what the arm was pushed with while holding.
        wrench ext-force {
            ref-point:  <ft_tree.wrist_ft_body.wrist_ft_site>,
            as-seen-by: <kinova.base_link.base_link_origin>,
            ft-sensor:  <wrist_ft>
        }
    },
    spec {
        // Shared, not per motion: the two states alternate, and a target re-captured on each
        // entry would follow the standing error and walk the hold away from where it began.
        pose start-pose       = snapshot of <shared.world.pose-ee-base>,
        // Six constraints leave the 7th joint free, so the elbow can sink under gravity with
        // the end-effector still on target. This is the actuator-4 bend the arm folds over --
        // everything beyond it hangs off this point. Held where it started, like the pose above.
        length support-z = snapshot of <shared.world.pose-elbow-base>.position.z,
        pose home-pose = [config.poses.home] for <shared.world.pose-ee-base>,
        pose look-wall-pose = [config.poses.look-wall-table] for <shared.world.pose-ee-base>,
        angle gripper-closed  = 0.8 rad,
        angle gripper-open    = 0.0 rad,
        angle grasp-threshold = 0.65 rad
    }
}

ros (ns=app) {
    publishers {
        ext-force-wrench: topic "/ee_wrench" message "geometry_msgs/msg/WrenchStamped",
        bdd-events: topic "/bdd/events" message "bdd_ros2_interfaces/msg/Event",
    },
    action-servers {
        collab-bhv: action "/bdd/collab_bhv_server" type "bdd_ros2_interfaces/action/Behaviour" {
            on-goal: produce event <collab-coord.E_GOAL>,
            on-end: { result.trinary.value: TRUE },
        },
    },
    always {
        publish at 20.0 Hz to <ros.publishers.ext-force-wrench> with <shared.world.ext-force>,
    },
}

// The bands this model is tuned against, stated once by the kind of error they bound rather
// than on each constraint that takes them.
tolerances {
    position:         0.05 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) look {
    description: "Move the TCP to the configured home pose"

    context { <shared.spec> }

    when {}

    while {
        home-position:
            keeping <shared.world.pose-ee-base>.position
            equal to <shared.spec.look-wall-pose>.position,
        home-orientation:
            keeping <shared.world.pose-ee-base>.orientation
            equal to <shared.spec.look-wall-pose>.orientation
    }

    until {
        at-home-position:
            <shared.world.pose-ee-base>.position
            equal to <shared.spec.look-wall-pose>.position,
        at-home-orientation:
            <shared.world.pose-ee-base>.orientation
            equal to <shared.spec.look-wall-pose>.orientation
    }
}

guarded-motion (ns=app) hold-close {
    description: "Hold the starting pose while the gripper closes"

    // The pose it holds is shared, so this motion captures nothing of its own.
    context { }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.start-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation,
        close-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed>,
        support-elbow-z:  keeping <shared.world.pose-elbow-base>.position.z equal to <shared.spec.support-z>
    }

    until {
        closed: <shared.world.gripper-pos> greater than <shared.spec.grasp-threshold>
    }
}

guarded-motion (ns=app) hold-open {
    description: "Hold the same pose while the gripper opens"

    context { }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.start-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation,
        open-gripper:     keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open>,
        support-elbow-z:  keeping <shared.world.pose-elbow-base>.position.z equal to <shared.spec.support-z>
    }

    until {
        opened: <shared.world.gripper-pos> equal to <shared.spec.gripper-open>
    }
}

guarded-motion (ns=app) hold-wait {
    description: "Hold the starting pose until a goal starts the cycle"

    context { }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.start-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation,
        open-gripper:     keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open>,
        support-elbow-z:  keeping <shared.world.pose-elbow-base>.position.z equal to <shared.spec.support-z>
    }

    // Nothing here ends it: the goal does, through the FSM.
    until {}
}

constraint-handler (ns=app) handler-wait {
    handles: <hold-wait>
    runs-in: <collab-coord.S_WAIT>
    controllers {
        pid ctrl-wait-hold-position    { <hold-wait.hold-position>,    Kp: 550, Ki: 50, Kd: 47, decay: 0 },
        pid ctrl-wait-hold-orientation { <hold-wait.hold-orientation>, Kp: 250, Ki: 50, Kd: 32, decay: 0 },
        feed-forward ctrl-wait-gripper { <hold-wait.open-gripper> },
        impedance ctrl-wait-support-z {
            <hold-wait.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        arm-solver: serial-chain {
            agent:     <collab-agents.kinova>,
            algorithm: rne,
            gravity:   (0.0, 0.0, -9.81) m/s^2
        },
        gripper-command-solver: command-forwarding {
            agent: <collab-agents.gripper>
        }
    }
}

constraint-handler (ns=app) handler-look {
    handles: <look>
    runs-in: <collab-coord.S_LOOK>
    monitors {
        mon-home: monitor <look.until> {
            satisfied for 0.3 s {
                trigger: event <collab-coord.E_OBJ_LOCATED>,
                publish: events { <collab-coord.E_PICK_START> } to <ros.publishers.bdd-events>
            },
        }
    }
    controllers {
        pid ctrl-look-position    { <look.home-position>,    Kp: 550, Ki: 50, Kd: 47, decay: 0 },
        pid ctrl-look-orientation { <look.home-orientation>, Kp: 250, Ki: 50, Kd: 32, decay: 0 }
    }
    solvers {
        <handler-wait.arm-solver>
    }
}

constraint-handler (ns=app) handler-touch {
    handles: <hold-close>
    runs-in: <collab-coord.S_TOUCH>
    monitors {
        mon-opened: monitor <hold-close.until> {
            satisfied for 0.3 s { trigger: event <collab-coord.E_TABLE_TOUCHED> },
        }
    }
    controllers {
        pid ctrl-touch-position    { <hold-close.hold-position>,    Kp: 550, Ki: 50, Kd: 2, decay: 0.1 },
        pid ctrl-touch-orientation { <hold-close.hold-orientation>, Kp: 250, Ki: 50, Kd: 2, decay: 0.1 },
        feed-forward ctrl-touch-gripper { <hold-close.close-gripper> },
        impedance ctrl-touch-support-z {
            <hold-close.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-slide {
    handles: <hold-open>
    runs-in: <collab-coord.S_SLIDE>
    monitors {
        mon-opened: monitor <hold-open.until> {
            satisfied for 0.3 s { trigger: event <collab-coord.E_OBJ_REACHED> },
        }
    }
    controllers {
        pid ctrl-slide-position    { <hold-open.hold-position>,    Kp: 550, Ki: 50, Kd: 47, decay: 0 },
        pid ctrl-slide-orientation { <hold-open.hold-orientation>, Kp: 250, Ki: 50, Kd: 32, decay: 0 },
        feed-forward ctrl-slide-gripper { <hold-open.open-gripper> },
        impedance ctrl-slide-support-z {
            <hold-open.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-close {
    handles: <hold-close>
    runs-in: <collab-coord.S_CLOSE>
    monitors {
        mon-opened: monitor <hold-close.until> {
            satisfied for 0.3 s {
                trigger: event <collab-coord.E_OBJ_GRASPED>,
                publish: events { <collab-coord.E_PICK_END> } to <ros.publishers.bdd-events>
            },
        }
    }
    controllers {
        pid ctrl-close-position    { <hold-close.hold-position>,    Kp: 550, Ki: 50, Kd: 2, decay: 0.1 },
        pid ctrl-close-orientation { <hold-close.hold-orientation>, Kp: 250, Ki: 50, Kd: 2, decay: 0.1 },
        feed-forward ctrl-close-gripper { <hold-close.close-gripper> },
        impedance ctrl-close-support-z {
            <hold-close.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-lift {
    handles: <hold-open>
    runs-in: <collab-coord.S_LIFT>
    monitors {
        mon-opened: monitor <hold-open.until> {
            satisfied for 0.3 s { trigger: event <collab-coord.E_HEIGHT_REACHED> },
        }
    }
    controllers {
        pid ctrl-lift-position    { <hold-open.hold-position>,    Kp: 550, Ki: 50, Kd: 47, decay: 0 },
        pid ctrl-lift-orientation { <hold-open.hold-orientation>, Kp: 250, Ki: 50, Kd: 32, decay: 0 },
        feed-forward ctrl-lift-gripper { <hold-open.open-gripper> },
        impedance ctrl-lift-support-z {
            <hold-open.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-traj {
    handles: <hold-close>
    runs-in: <collab-coord.S_FOLLOW_TRAJ>
    monitors {
        mon-opened: monitor <hold-close.until> {
            satisfied for 0.3 s { trigger: event <collab-coord.E_FORCE_DETECTED> },
        }
    }
    controllers {
        pid ctrl-traj-position    { <hold-close.hold-position>,    Kp: 550, Ki: 50, Kd: 2, decay: 0.1 },
        pid ctrl-traj-orientation { <hold-close.hold-orientation>, Kp: 250, Ki: 50, Kd: 2, decay: 0.1 },
        feed-forward ctrl-traj-gripper { <hold-close.close-gripper> },
        impedance ctrl-traj-support-z {
            <hold-close.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-comply {
    handles: <hold-open>
    runs-in: <collab-coord.S_COMPLIANT>
    monitors {
        mon-opened: monitor <hold-open.until> {
            satisfied for 0.3 s {
                trigger: event <collab-coord.E_DEST_REACHED>,
                publish: events { <collab-coord.E_PLACE_START> } to <ros.publishers.bdd-events>
            }
        }
    }
    controllers {
        pid ctrl-comply-position    { <hold-open.hold-position>,    Kp: 550, Ki: 50, Kd: 47, decay: 0 },
        pid ctrl-comply-orientation { <hold-open.hold-orientation>, Kp: 250, Ki: 50, Kd: 32, decay: 0 },
        feed-forward ctrl-comply-gripper { <hold-open.open-gripper> },
        impedance ctrl-comply-support-z {
            <hold-open.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-lower {
    handles: <hold-close>
    runs-in: <collab-coord.S_LOWER>
    monitors {
        mon-opened: monitor <hold-close.until> {
            satisfied for 0.3 s {
                trigger: event <collab-coord.E_TABLE_TOUCHED>,
                publish: events { <collab-coord.E_PLACE_END> } to <ros.publishers.bdd-events>
            },
        }
    }
    controllers {
        pid ctrl-lower-position    { <hold-close.hold-position>,    Kp: 550, Ki: 50, Kd: 2, decay: 0.1 },
        pid ctrl-lower-orientation { <hold-close.hold-orientation>, Kp: 250, Ki: 50, Kd: 2, decay: 0.1 },
        feed-forward ctrl-lower-gripper { <hold-close.close-gripper> },
        impedance ctrl-lower-support-z {
            <hold-close.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-open {
    handles: <hold-open>
    runs-in: <collab-coord.S_OPEN>
    monitors {
        mon-opened: monitor <hold-open.until> {
            satisfied for 0.3 s { trigger: event <collab-coord.E_OBJ_RELEASED> }
        }
    }
    controllers {
        pid ctrl-open-position    { <hold-open.hold-position>,    Kp: 550, Ki: 50, Kd: 47, decay: 0 },
        pid ctrl-open-orientation { <hold-open.hold-orientation>, Kp: 250, Ki: 50, Kd: 32, decay: 0 },
        feed-forward ctrl-open-gripper { <hold-open.open-gripper> },
        impedance ctrl-open-support-z {
            <hold-open.support-elbow-z>, Ki: 200, stiffness: 2500, damping: 80
        }
        apply at <kinova.forearm_link>
    }
    solvers {
        <handler-wait.arm-solver>,
        <handler-wait.gripper-command-solver>
    }
}
