import "./collab_real.fsm"
import "../collab/collab.scenex"
ns app = "https://secorolab.github.io/models/demos/collab/exec/"

exec-context (ns=app) real-demo-collab-exec {
    runs-scene: <collab-scene-simreal>
    platform:   real-world {
                    <collab-agents.kinova> realized by KinovaGen3,
                    <collab-agents.gripper> realized by Robotiq2F85,
                    <collab-scene-simreal.wrist_ft> realized by RobotiqFT300s
                }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        joint-position joint-3-angle {
            joint: <kinova.joint_3>,
            normalization: (-pi, pi) rad
        },
        joint-position joint-4-angle {
            joint: <kinova.joint_4>,
            normalization: (-pi, pi) rad
        },
        joint-position joint-6-angle {
            joint: <kinova.joint_6>,
            normalization: (-pi, pi) rad
        },
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        wrench press-wrench {
            of:         <gripper.g_base.g_pinch>,
            ref-point:  <gripper.g_base.g_pinch>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        // Not controlled: recorded, so the run says what the arm was pushed with while holding.
        wrench ext-force {
            ref-point:  <ft_tree.wrist_ft_body.wrist_ft_site>,
            as-seen-by: <kinova.base_link.base_link_origin>,
            ft-sensor:  <wrist_ft>
        }
    },
    spec {
        // Shared, not per motion: the two states alternate, and a target re-captured on each
        // entry would follow the standing error and walk the hold away from where it began.
        pose start-pose             = snapshot of <shared.world.pose-ee-base>,
        pose look-table             = [config.poses.look-table] for <shared.world.pose-ee-base>,
        pose touch_align_pose       = [config.poses.touch-align] for <shared.world.pose-ee-base>,
        angle gripper-closed        = 0.8 rad,
        angle gripper-open          = 0.0 rad,
        angle grasp-threshold       = 0.5 rad,
        linear-velocity zero-linvel = 0.0 m/s,
        linear-velocity descend-vel = -0.05 m/s,
        linear-velocity slide-vel   = -0.05 m/s,
        force press-force           = -20.0 N,
        force press-band            = 0.5 N,
        length touchdown-z          = 0.1 m,
        length slide-target-y       = -0.75 m,
        length lift-height-z        = 0.1 m,
        angle joint-3-target        = 3.14 rad,
        angle joint-7-target        = 1.57 rad,
        angle joint-4-upper-limit   = -45.0 deg,
        angle joint-4-lower-limit   = -144.0 deg,
        angle joint-6-upper-limit   = 116.0 deg,
        angle joint-6-lower-limit   = -117.0 deg
    }
}

ros (ns=app) {
    publishers {
        ext-force-wrench: topic "/ee_wrench" message "geometry_msgs/msg/WrenchStamped",
        bdd-events: topic "/bdd/events" message "bdd_ros2_interfaces/msg/Event",
    },
    //action-servers {
    //    collab-bhv: action "/bdd/collab_bhv_server" type "bdd_ros2_interfaces/action/Behaviour" {
    //        on-goal: produce event <collab-coord.E_GOAL>,
    //    },
    //},
    always {
        publish at 100.0 Hz to <ros.publishers.ext-force-wrench> with <shared.world.ext-force>,
    },
}

// The bands this model is tuned against, stated once by the kind of error they bound rather
// than on each constraint that takes them.
tolerances {
    position:         0.01 m,
    linear-velocity:  0.01 m/s,
    orientation:      5 deg
}



guarded-motion (ns=app) hold-wait {
    description: "Hold the starting pose until a goal starts the cycle, the arm is stable, and the gripper is open"

    context { }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.start-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation,
        open-gripper:     keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open>,
        hold-elbow:       keeping <shared.world.joint-3-angle> equal to <shared.spec.joint-3-target>,
        joint-4-range:    <shared.world.joint-4-angle> between <shared.spec.joint-4-lower-limit> and <shared.spec.joint-4-upper-limit>,
        joint-6-range:    <shared.world.joint-6-angle> between <shared.spec.joint-6-lower-limit> and <shared.spec.joint-6-upper-limit>
    }

    until all {
        settled-x-vel: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        settled-y-vel: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        settled-z-vel: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>,
        at-start-position: <shared.world.pose-ee-base>.position equal to <shared.spec.start-pose>.position,
        at-start-orientation: <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation,
        opened: <shared.world.gripper-pos> equal to <shared.spec.gripper-open>
    }
}

constraint-handler (ns=app) handler-hold-wait {
    handles: <hold-wait>
    runs-in: <collab-coord.S_WAIT>
    monitors {
        mon-home-settled: monitor <hold-wait.until> {
            satisfied for 0.5 s { trigger: event <collab-coord.E_GOAL> }
        }
    }
    controllers {
        pid ctrl-home-position { constraint: <hold-wait.hold-position>,             Kp: 500, Ki: 20, Kd: 100, decay: 0 },
        impedance ctrl-home-ori { constraint: <hold-wait.hold-orientation>, stiffness: 15, damping: 2 } apply at <gripper.g_base>,
        feed-forward ctrl-home-gripper { constraint: <hold-wait.open-gripper> },
        pid ctrl-home-joint-3 { constraint: <hold-wait.hold-elbow>,                 Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-home-joint-4-range { constraint: <hold-wait.joint-4-range>,        Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-home-joint-6-range { constraint: <hold-wait.joint-6-range>,        Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers {
        arm-solver: serial-chain {
            agent: <collab-agents.kinova>, algorithm: rne, gravity: (0.0, 0.0, -9.81) m/s^2
        },
        gripper-command-solver: command-forwarding { agent: <collab-agents.gripper> }
    }
}


guarded-motion (ns=app) go-look {
    description: "Follow the Cartesian arc trajectory from home to look-table pose"

    context {
        <shared.spec>,
        spec {
            velocity-profile speed-profile = profile {
                max-velocity: 0.15 m/s,
                max-acceleration: 0.03 m/s^2,
                shape: trapezoidal
            },
            direction path-normal { as-seen-by: <kinova.base_link.base_link_origin> } = (0.0, 0.0, 1.0),

            // Arc deviation from the straight chord
            distance arc-height = 0.35 m,

            pose start-pose = snapshot of <shared.world.pose-ee-base>,

            path arc-path = arc {
                start:        <spec.start-pose>,
                end:          <shared.spec.look-table>,
                amplitude:    <spec.arc-height>,
                plane-normal: <spec.path-normal>
            },

            length satisfied-dist-band     = 0.03 m,
            angle satisfied-orientation-band = 10 deg
        }
    }

    when {}

    while {
        tangent:            moving <shared.world.pose-ee-base> along <spec.arc-path> with <spec.speed-profile>,
        follow-position:    keeping <shared.world.pose-ee-base>.position on <spec.arc-path>,
        follow-orientation: keeping <shared.world.pose-ee-base>.orientation on <spec.arc-path>,
        hold-elbow:         keeping <shared.world.joint-3-angle> equal to <shared.spec.joint-3-target>,
        joint-4-range:      <shared.world.joint-4-angle> between <shared.spec.joint-4-lower-limit> and <shared.spec.joint-4-upper-limit>,
        joint-6-range:      <shared.world.joint-6-angle> between <shared.spec.joint-6-lower-limit> and <shared.spec.joint-6-upper-limit>
    }

    until all {
        settled-x-vel: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        settled-y-vel: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        settled-z-vel: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>,
        at-go-look-position: <shared.world.pose-ee-base>.position equal to <shared.spec.look-table>.position within <spec.satisfied-dist-band>,
        at-go-look-orientation: <shared.world.pose-ee-base>.orientation equal to <shared.spec.look-table>.orientation within <spec.satisfied-orientation-band>
    }
}

constraint-handler (ns=app) handler-go-look {
    handles: <go-look>
    runs-in: <collab-coord.S_LOOK>
    monitors {
        mon-opened: monitor <go-look.until> {
            satisfied for 0.5 s { trigger: event <collab-coord.E_OBJ_LOCATED> },
        }
    }
    controllers {
        pid ctrl-look-tangent { constraint: <go-look.tangent>, Kp: 200, Ki: 15, Kd: 0.1, decay: 0 },
        pid ctrl-look-position { constraint: <go-look.follow-position>,           Kp: 200, Ki: 15, Kd: 0.1, decay: 0 },
        impedance ctrl-look-ori { constraint: <go-look.follow-orientation>, stiffness: 25, damping: 2 } apply at <gripper.g_base>,
        pid ctrl-look-joint-3 { constraint: <go-look.hold-elbow>,                    Kp: 200, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-look-joint-4-range { constraint: <go-look.joint-4-range>,           Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-look-joint-6-range { constraint: <go-look.joint-6-range>,           Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers { <handler-hold-wait.arm-solver> }
}


guarded-motion (ns=app) touch-align {
    description: "Realign TCP orientation to match the table's surface normal"

    context {
        spec {
            pose touchdown-start-pose = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        touch-align-position: keeping <shared.world.pose-ee-base>.position equal to <spec.touchdown-start-pose>.position,
        touch-align-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.touch_align_pose>.orientation,
        hold-elbow: keeping <shared.world.joint-3-angle> equal to <shared.spec.joint-3-target>,
        joint-4-range: <shared.world.joint-4-angle> between <shared.spec.joint-4-lower-limit> and <shared.spec.joint-4-upper-limit>,
        joint-6-range: <shared.world.joint-6-angle> between <shared.spec.joint-6-lower-limit> and <shared.spec.joint-6-upper-limit>
    }

    until all {
        at-touch-reorient-orientation: <shared.world.pose-ee-base>.orientation equal to <shared.spec.touch_align_pose>.orientation
    }
}

constraint-handler (ns=app) handler-touch-align {
    handles: <touch-align>
    runs-in: <collab-coord.S_TOUCH_ALIGN>
    monitors {
        mon-opened: monitor <touch-align.until> {
            satisfied for 0.5 s { trigger: event <collab-coord.E_TABLE_TOUCH_REORIENTED> },
        }
    }
    controllers {
        pid ctrl-touch-align-orient-position { constraint: <touch-align-position>,              Kp: 500, Ki: 20, Kd: 100, decay: 0 },
        impedance ctrl-touch-align-ori { constraint: <touch-align-orientation>, stiffness: 15, damping: 2 } apply at <gripper.g_base>,
        pid ctrl-touch-align-joint-3 { constraint: <touch-align.hold-elbow>,                    Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-touch-align-joint-4-range { constraint: <touch-align.joint-4-range>,           Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-touch-align-joint-6-range { constraint: <touch-align.joint-6-range>,           Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers { <handler-hold-wait.arm-solver> }
}


guarded-motion (ns=app) touchdown {
    description: "Lower the TCP until it is near table surface with near-zero vertical velocity"

    context {
        spec {
            pose touchdown-start-pose = snapshot of <shared.world.pose-ee-base>,
            length hold-x = snapshot of <shared.world.pose-ee-base>.position.x,
            length hold-y = snapshot of <shared.world.pose-ee-base>.position.y
        }
    }

    when {}

    while {
        hold-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        lower-z: keeping <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.descend-vel>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.touchdown-start-pose>.orientation,
        hold-elbow: keeping <shared.world.joint-3-angle> equal to <shared.spec.joint-3-target>,
        joint-4-range: <shared.world.joint-4-angle> between <shared.spec.joint-4-lower-limit> and <shared.spec.joint-4-upper-limit>,
        joint-6-range: <shared.world.joint-6-angle> between <shared.spec.joint-6-lower-limit> and <shared.spec.joint-6-upper-limit>
    }

    until all {
        touchdown-z: <shared.world.pose-ee-base>.position.z less than <shared.spec.touchdown-z>,
        touchdown-z-velocity: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}

constraint-handler (ns=app) handler-touchdown {
    handles: <touchdown>
    runs-in: <collab-coord.S_TOUCH>
    monitors {
        mon-opened: monitor <touchdown.until> {
            satisfied for 0.5 s { trigger: event <collab-coord.E_TABLE_TOUCHED> },
        }
    }
    controllers {
        pid ctrl-touchdown-x { constraint: <touchdown.hold-x>,                              Kp: 150, Ki: 5, Kd: 0.1, decay: 0 },
        pid ctrl-touchdown-y { constraint: <touchdown.hold-y>,                              Kp: 150, Ki: 5, Kd: 0.1, decay: 0 },
        pid ctrl-touchdown-z { constraint: <touchdown.lower-z>,                             Kp: 175, Ki: 5, Kd: 0.1, decay: 0 },
        impedance ctrl-touchdown-ori { constraint: <touchdown.hold-orientation>, stiffness: 15, damping: 2 } apply at <gripper.g_base>,
        pid ctrl-touchdown-joint-3 { constraint: <touchdown.hold-elbow>,                    Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-touchdown-joint-4-range { constraint: <touchdown.joint-4-range>,           Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-touchdown-joint-6-range { constraint: <touchdown.joint-6-range>,           Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers { <handler-hold-wait.arm-solver> }
}



guarded-motion (ns=app) forward_motion {
    description: "Slide the TCP forward until the TCP crosses threshold"

    context {
        spec {
            length hold-x = snapshot of <shared.world.pose-ee-base>.position.x,
            pose target-pose = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        move-forward-neg-y: keeping <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.slide-vel>,
        hold-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        press-down: keeping <shared.world.press-wrench>.force.z equal to <shared.spec.press-force> within <shared.spec.press-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.target-pose>.orientation,
        hold-elbow: keeping <shared.world.joint-3-angle> equal to <shared.spec.joint-3-target>,
        joint-4-range: <shared.world.joint-4-angle> between <shared.spec.joint-4-lower-limit> and <shared.spec.joint-4-upper-limit>,
        joint-6-range: <shared.world.joint-6-angle> between <shared.spec.joint-6-lower-limit> and <shared.spec.joint-6-upper-limit>
    }

    until all {
        reached-forward: <shared.world.pose-ee-base>.position.y less than <shared.spec.slide-target-y>,
        touchdown-z: <shared.world.pose-ee-base>.position.z less than <shared.spec.touchdown-z>
    }
}

constraint-handler (ns=app) handler-forward {
    handles: <forward_motion>
    runs-in: <collab-coord.S_SLIDE>
    monitors {
        mon-forward-done: monitor <forward_motion.until> {
            satisfied for 0.5 s { trigger: event <collab-coord.E_OBJ_REACHED> },
        }
    }
    controllers {
        pid ctrl-forward-neg-y { constraint: <forward_motion.move-forward-neg-y>,               Kp: 100, Ki: 5, Kd: 0.1, decay: 0 },
        pid ctrl-forward-x { constraint: <forward_motion.hold-x>,                               Kp: 75, Ki: 5, Kd: 0.1, decay: 0 },
        feed-forward ctrl-forward_motion-press-down { constraint: <forward_motion.press-down> }
            as force
            apply at <gripper.g_base>,
        impedance ctrl-forward-ori { constraint: <forward_motion.hold-orientation>, stiffness: 15, damping: 2 } apply at <gripper.g_base>,
        pid ctrl-forward-joint-3 { constraint: <forward_motion.hold-elbow>,                     Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-forward-joint-4-range { constraint: <forward_motion.joint-4-range>,            Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-forward-joint-6-range { constraint: <forward_motion.joint-6-range>,            Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers { <handler-hold-wait.arm-solver> }
}



guarded-motion (ns=app) hold-close {
    description: "Hold the current pose until the arm is stable and the gripper is closed"

    context {
        spec {
            pose target-pose = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        close-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed>,
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <spec.target-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.target-pose>.orientation,
        hold-elbow:       keeping <shared.world.joint-3-angle> equal to <shared.spec.joint-3-target>,
        joint-4-range:    <shared.world.joint-4-angle> between <shared.spec.joint-4-lower-limit> and <shared.spec.joint-4-upper-limit>,
        joint-6-range:    <shared.world.joint-6-angle> between <shared.spec.joint-6-lower-limit> and <shared.spec.joint-6-upper-limit>
    }

    until all {
        settled-x-vel: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        settled-y-vel: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        settled-z-vel: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>,
        at-target-position: <shared.world.pose-ee-base>.position equal to <spec.target-pose>.position,
        grasped: <shared.world.gripper-pos> greater than <shared.spec.grasp-threshold>
    }
}

constraint-handler (ns=app) handler-hold-close {
    handles: <hold-close>
    runs-in: <collab-coord.S_CLOSE>
    monitors {
        mon-closed: monitor <hold-close.until> {
            satisfied for 1 s { 
                    trigger: event <collab-coord.E_OBJ_GRASPED>,
                    publish: event to <ros.publishers.bdd-events>
                    //, result: succeeded <ros.action-servers.collab-bhv> { result.trinary.value: TRUE }
            }
        }
    }
    controllers {
        pid ctrl-hold-close-position { constraint: <hold-close.hold-position>,              Kp: 500, Ki: 20, Kd: 100, decay: 0 },
        feed-forward ctrl-hold-close-gripper { constraint: <hold-close.close-gripper> },
        impedance ctrl-hold-close-ori { constraint: <hold-close.hold-orientation>, stiffness: 15, damping: 2 } apply at <gripper.g_base>,
        pid ctrl-hold-close-joint-3 { constraint: <hold-close.hold-elbow>,                  Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-hold-close-joint-4-range { constraint: <hold-close.joint-4-range>,         Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-hold-close-joint-6-range { constraint: <hold-close.joint-6-range>,         Kp: 200, Ki: 0, Kd: 0, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers {
        <handler-hold-wait.arm-solver>,
        <handler-hold-wait.gripper-command-solver>
    }
}