ns rdh = "https://secorolab.github.io/models/sim-demo-incremental/fsm/"

evt loop (ns=rdh) sim_demo_incremental_fsm_events {
    evt E_STEP,
    evt E_GRIPPER_CLOSED,
    evt E_GRIPPER_OPENED
}

fsm (ns=rdh) sim_demo_incremental_fsm {
    description: "Hold the pose the arm started in while the gripper cycles."

    states {
        S_START,
        S_CLOSE,
        S_OPEN,
        S_DONE
    }

    evt loop: <sim_demo_incremental_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_CLOSE { from: <S_START>, to: <S_CLOSE> },
        T_CLOSE_OPEN  { from: <S_CLOSE>, to: <S_OPEN> },
        T_OPEN_CLOSE  { from: <S_OPEN>,  to: <S_CLOSE> }
    }

    reactions {
        R_STEP_START     { when: <sim_demo_incremental_fsm_events.E_STEP>,           do: <T_START_CLOSE> },
        R_GRIPPER_CLOSED { when: <sim_demo_incremental_fsm_events.E_GRIPPER_CLOSED>, do: <T_CLOSE_OPEN> },
        R_GRIPPER_OPENED { when: <sim_demo_incremental_fsm_events.E_GRIPPER_OPENED>, do: <T_OPEN_CLOSE> }
    }
}
