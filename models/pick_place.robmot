ns app = "https://secorolab.github.io/models/pick-place/"

ENVIRONMENT (ns=app) pick-place-env {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset {
            model: KinovaGen3,
            xml: "src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml"
        },
        gripper-mjcf: AttachmentAsset {
            xml: "src/mj_kdl_wrapper/third_party/menagerie/robotiq_2f85/2f85.xml"
        },
        table-mjcf: SceneObject {
            xml: "src/mj_kdl_wrapper/src/examples/assets/table.xml",
            body: table
        },
        cube-object: SceneObject {
            body: cube
        }
    },
    ASSEMBLY {
        table: <table-mjcf> {
            position: { z: 0.72 m },
            orientation: {}
        },
        robot: <kinova-mjcf> {
            attach <gripper-mjcf> to bracelet_link {
                prefix: g_,
                position: { z: -0.061525 m },
                orientation: { roll: 180 deg },
                actuator: g_fingers_actuator,
                open: 0.0,
                closed: 255.0
            },
            position: { z: 0.72 m },
            orientation: {},
            tool-body: g_base,
            tcp-site: g_pinch,
            chain: { root: base_link, end: g_pinch }
        },
        cube: <cube-object> {
            position: { x: 0.50 m, z: 0.745 m },
            orientation: {},
            free: true,
            shape: box,
            size: { x: 0.03 m, y: 0.03 m, z: 0.03 m },
            mass: 0.1,
            friction: { slide: 0.8, torsion: 0.01, roll: 0.0001 }
        }
    }
}

CONTEXT (ns=app) shared {
    world: World {
        cube:             SceneObject,
        table:            SceneObject,
        half-arm-2-link:  Link,
        gravity:          Gravity,
        pose-ee-base:     Pose { of: g_pinch, wrt: base_link, as-seen-by: base_link },
        twist-ee-base:    VelocityTwist { of: g_pinch, wrt: base_link, as-seen-by: base_link },
        pose-cube-base:   Pose { of: cube, wrt: base_link, as-seen-by: base_link },
        pose-elbow-base:  Pose { of: half_arm_2_link, wrt: base_link, as-seen-by: base_link }
    },
    spec: Spec {
        zero-linvel: LinearVelocity = 0.0 m/s,
        zero-dist:   LinearDistance = 0.0 m,
        grasp-roll:  Angle = 3.14159 rad,
        grasp-pitch: Angle = 0.0 rad,
        grasp-yaw:   Angle = 1.5708 rad,
        gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
    }
}

MOTION_SPEC (ns=app) home {
    MOVE: "Hold the TCP at the startup home pose"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            home-pose:  Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <spec.home-pose>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.home-pose>
    }

    UNTIL all {
        at-home-settled: <shared.world.pose-ee-base> equal to <spec.home-pose>
    }
}

MOTION_SPEC (ns=app) pick-above {
    MOVE: "Move TCP to the pre-grasp position above the cube"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            // absolute EE z in robot-base frame = cube_base_z (~0.04) + 0.22m above cube
            above-z:       LinearDistance = 0.26 m,
            alpha:         TrajectoryProgress,
            start-pose:    Pose = Snapshot of <shared.world.pose-ee-base>,
            start-cube-x:  LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.x,
            start-cube-y:  LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.y,
            goal-pose:  Pose {
                position: {
                    x: <spec.start-cube-x>,
                    y: <spec.start-cube-y>,
                    z: <spec.above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            traj: Trajectory = Lerp {
                start: <spec.start-pose>,
                goal:  <spec.goal-pose>,
                alpha: <spec.alpha>
            }
        }
    }

    WHEN {
        lin-x-at-rest: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-at-rest: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-at-rest: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.traj>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.traj>
    }

    UNTIL all {
        at-pick-above-settled: <shared.world.pose-ee-base> equal to <spec.goal-pose>
    }
}

MOTION_SPEC (ns=app) pick {
    MOVE: "Lower TCP to the grasp height at the cube"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            grasp-x:     LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.x,
            grasp-y:     LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.y,
            grasp-z:     LinearDistance = 0.05 m,
            grasp-reach: LinearDistance = 0.05 m,
            grasp-orientation: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {
        lin-x-at-rest: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-at-rest: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-at-rest: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        reach-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.grasp-x>,
        reach-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.grasp-y>,
        reach-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.grasp-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.grasp-orientation>
    }

    UNTIL all {
        at-pick-x: <shared.world.pose-ee-base>.position.x equal to <spec.grasp-x>,
        at-pick-y: <shared.world.pose-ee-base>.position.y equal to <spec.grasp-y>,
        at-pick-z: <shared.world.pose-ee-base>.position.z equal to <spec.grasp-z>,
        near-cube: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <pick.spec.grasp-reach>
    }
}

MOTION_SPEC (ns=app) grasp-hold {
    MOVE: "Hold TCP at the current base-frame pose while the gripper actuates"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            hold-x:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            hold-y:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            hold-z:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.z,
            support-z: LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z,
            hold-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        hold-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) lift {
    MOVE: "Raise TCP in the base frame while maintaining grip on the cube"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            lift-x: LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            lift-y: LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            lift-z: LinearDistance = 0.4 m,
            lift-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            lift-z-up: LinearDistance = 0.2 m
        }
    }

    WHEN {
        at-grasp: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <pick.spec.grasp-reach>
    }

    WHILE {
        reach-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.lift-x>,
        reach-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.lift-y>,
        reach-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.lift-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.lift-orientation-pose>
    }

    UNTIL all {
        at-lift-x: <shared.world.pose-ee-base>.position.x equal to <spec.lift-x>,
        at-lift-y: <shared.world.pose-ee-base>.position.y equal to <spec.lift-y>,
        at-lift-z: <shared.world.pose-ee-base>.position.z greater than <spec.lift-z-up>
    }
}

MOTION_SPEC (ns=app) place-above {
    MOVE: "Move TCP laterally to the pre-place position above the place location"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            place-x: LinearDistance = 0.40 m,
            place-y: LinearDistance = 0.24 m,
            place-above-z: LinearDistance = 0.4 m,
            place-above-up-z: LinearDistance = 0.2 m,
            support-z: LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z,
            place-above-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {
        lin-z-at-lift: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        reach-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.place-x>,
        reach-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.place-y>,
        reach-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.place-above-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.place-above-orientation-pose>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL all {
        at-place-above-x: <shared.world.pose-ee-base>.position.x equal to <spec.place-x>,
        at-place-above-y: <shared.world.pose-ee-base>.position.y equal to <spec.place-y>,
        at-place-above-z: <shared.world.pose-ee-base>.position.z greater than <spec.place-above-up-z>
    }
}

MOTION_SPEC (ns=app) place {
    MOVE: "Lower TCP to the place height at the place location"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            place-z: LinearDistance = 0.075 m,
            support-z: LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z,
            place-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {
        lin-x-at-rest: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-at-rest: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-at-rest: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        reach-x: keeping <shared.world.pose-ee-base>.position.x equal to <place-above.spec.place-x>,
        reach-y: keeping <shared.world.pose-ee-base>.position.y equal to <place-above.spec.place-y>,
        reach-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.place-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.place-orientation-pose>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL all {
        at-place-x: <shared.world.pose-ee-base>.position.x equal to <place-above.spec.place-x>,
        at-place-y: <shared.world.pose-ee-base>.position.y equal to <place-above.spec.place-y>,
        at-place-z: <shared.world.pose-ee-base>.position.z equal to <spec.place-z>
    }
}

MOTION_SPEC (ns=app) retreat {
    MOVE: "Raise TCP away from the place location after releasing the object"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            support-z: LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z,
            retreat-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {
        lin-z-at-place: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        reach-x: keeping <shared.world.pose-ee-base>.position.x equal to <place-above.spec.place-x>,
        reach-y: keeping <shared.world.pose-ee-base>.position.y equal to <place-above.spec.place-y>,
        reach-z: keeping <shared.world.pose-ee-base>.position.z equal to <place-above.spec.place-above-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.retreat-orientation-pose>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL all {
        at-retreat-x: <shared.world.pose-ee-base>.position.x equal to <place-above.spec.place-x>,
        at-retreat-y: <shared.world.pose-ee-base>.position.y equal to <place-above.spec.place-y>,
        at-retreat-z: <shared.world.pose-ee-base>.position.z equal to <place-above.spec.place-above-z>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-home {
    CONTEXT {
        <shared.world>,
        <shared.spec>
    }

    MOTION: <home>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-home-settled: monitor <home.at-home-settled> and trigger event home-settled when active
    }

    CONTROLLERS {
        ctrl-hold-position:    PID { constraint: <home.hold-position>,    Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-hold-orientation: PID { constraint: <home.hold-orientation>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        arm-solver: Solver {
            robot:     <pick-place-env.robot>,
            algorithm: ACHD,
            root:      <pick-place-env.robot.chain.root>,
            end:       <pick-place-env.robot.chain.end>,
            gravity:   <shared.world.gravity> equal to <shared.spec.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-pick-above {
    CONTEXT {}

    MOTION: <pick-above>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-pick-above-settled: monitor <pick-above.at-pick-above-settled> and trigger event pick-above-settled when active
    }

    CONTROLLERS {
        ctrl-pa-follow-pos: PID { constraint: <pick-above.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pa-follow-ori: PID { constraint: <pick-above.follow-ori>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-pick {
    CONTEXT {}

    MOTION: <pick>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-pick-x:    monitor <pick.at-pick-x> and trigger event pick-x-reached when active,
        mon-pick-y:    monitor <pick.at-pick-y> and trigger event pick-y-reached when active,
        mon-pick-z:    monitor <pick.at-pick-z> and trigger event pick-z-reached when active,
        mon-near-cube: monitor <pick.near-cube> and trigger event near-cube when active
    }

    CONTROLLERS {
        ctrl-pk-reach-x: PID { constraint: <pick.reach-x>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pk-reach-y: PID { constraint: <pick.reach-y>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pk-reach-z: PID { constraint: <pick.reach-z>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pk-hold-orientation: PID { constraint: <pick.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-close-grip {
    CONTEXT {}

    MOTION: <grasp-hold>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-at-cube: monitor <grasp-hold.hold-x> and trigger event at-grasp when active
    }

    ACTIONS {
        close-gripper: gripper <pick-place-env.gripper-mjcf> close
    }

    CONTROLLERS {
        ctrl-cg-hold-x:      PID { constraint: <grasp-hold.hold-x>,      Kp = 100, Ki = 50, Kd = 20, decay = 0.9 },
        ctrl-cg-hold-y:      PID { constraint: <grasp-hold.hold-y>,      Kp = 100, Ki = 50, Kd = 20, decay = 0.9 },
        ctrl-cg-hold-z:      PID { constraint: <grasp-hold.hold-z>,      Kp = 100, Ki = 50, Kd = 20, decay = 0.9 },
        ctrl-cg-hold-orientation: PID { constraint: <grasp-hold.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-lift {
    CONTEXT {}

    MOTION: <lift>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-lift-x: monitor <lift.at-lift-x> and trigger event lift-x-reached when active,
        mon-lift-y: monitor <lift.at-lift-y> and trigger event lift-y-reached when active,
        mon-lift-z: monitor <lift.at-lift-z> and trigger event lift-z-reached when active
    }

    CONTROLLERS {
        ctrl-lt-reach-x: PID { constraint: <lift.reach-x>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-lt-reach-y: PID { constraint: <lift.reach-y>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-lt-reach-z: PID { constraint: <lift.reach-z>, Kp = 180, Ki = 0, Kd = 60, decay = 0 },
        ctrl-lt-hold-orientation: PID { constraint: <lift.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-place-above {
    CONTEXT {}

    MOTION: <place-above>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-place-above-x: monitor <place-above.at-place-above-x> and trigger event place-above-x-reached when active,
        mon-place-above-y: monitor <place-above.at-place-above-y> and trigger event place-above-y-reached when active,
        mon-place-above-z: monitor <place-above.at-place-above-z> and trigger event place-above-z-reached when active
    }

    CONTROLLERS {
        ctrl-pla-reach-x: PID { constraint: <place-above.reach-x>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pla-reach-y: PID { constraint: <place-above.reach-y>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pla-reach-z: PID { constraint: <place-above.reach-z>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pla-hold-orientation: PID { constraint: <place-above.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-pla-support-z:   Impedance { constraint: <place-above.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-place {
    CONTEXT {}

    MOTION: <place>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-place-x: monitor <place.at-place-x> and trigger event place-x-reached when active,
        mon-place-y: monitor <place.at-place-y> and trigger event place-y-reached when active,
        mon-place-z: monitor <place.at-place-z> and trigger event place-z-reached when active
    }

    CONTROLLERS {
        ctrl-pl-reach-x: PID { constraint: <place.reach-x>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pl-reach-y: PID { constraint: <place.reach-y>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pl-reach-z: PID { constraint: <place.reach-z>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-pl-hold-orientation: PID { constraint: <place.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-pl-support-z:   Impedance { constraint: <place.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-open-grip {
    CONTEXT {}

    MOTION: <grasp-hold>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-at-place: monitor <grasp-hold.hold-x> and trigger event at-place when active
    }

    ACTIONS {
        open-gripper: gripper <pick-place-env.gripper-mjcf> open
    }

    CONTROLLERS {
        ctrl-og-hold-x:      PID { constraint: <grasp-hold.hold-x>,      Kp = 100, Ki = 50, Kd = 20, decay = 0.9 },
        ctrl-og-hold-y:      PID { constraint: <grasp-hold.hold-y>,      Kp = 100, Ki = 50, Kd = 20, decay = 0.9 },
        ctrl-og-hold-z:      PID { constraint: <grasp-hold.hold-z>,      Kp = 100, Ki = 50, Kd = 20, decay = 0.9 },
        ctrl-og-hold-orientation: PID { constraint: <grasp-hold.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-og-support-z:   Impedance { constraint: <grasp-hold.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-retreat {
    CONTEXT {}

    MOTION: <retreat>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-retreat-x: monitor <retreat.at-retreat-x> and trigger event retreat-x-reached when active,
        mon-retreat-y: monitor <retreat.at-retreat-y> and trigger event retreat-y-reached when active,
        mon-retreat-z: monitor <retreat.at-retreat-z> and trigger event retreat-z-reached when active
    }

    CONTROLLERS {
        ctrl-rt-reach-x: PID { constraint: <retreat.reach-x>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-rt-reach-y: PID { constraint: <retreat.reach-y>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-rt-reach-z: PID { constraint: <retreat.reach-z>, Kp = 120, Ki = 0, Kd = 60, decay = 0 },
        ctrl-rt-hold-orientation: PID { constraint: <retreat.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-rt-support-z:   Impedance { constraint: <retreat.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}
