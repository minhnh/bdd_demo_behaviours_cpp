ns app = "https://secorolab.github.io/models/pick-place/"

ENVIRONMENT (ns=app) pick-place-env {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset {
            model: KinovaGen3,
            xml: "src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml"
        },
        gripper-mjcf: AttachmentAsset {
            xml: "src/mj_kdl_wrapper/third_party/menagerie/robotiq_2f85/2f85.xml"
        },
        table-mjcf: SceneObject {
            xml: "src/mj_kdl_wrapper/src/examples/assets/table.xml",
            body: table
        },
        cube-object: SceneObject {
            body: cube
        }
    },
    ASSEMBLY {
        table: <table-mjcf> {
            position: { z: 0.72 m },
            orientation: {}
        },
        robot: <kinova-mjcf> {
            attach <gripper-mjcf> to bracelet_link {
                prefix: g_,
                position: { z: -0.061525 m },
                orientation: { roll: 180 deg },
                actuator: g_fingers_actuator,
                open: 0.0,
                closed: 255.0
            },
            position: { z: 0.72 m },
            orientation: {},
            tool-body: g_base,
            tcp-site: g_pinch,
            chain: { root: base_link, end: g_pinch }
        },
        cube: <cube-object> {
            position: { x: 0.50 m, z: 0.75 m },
            orientation: {},
            free: true,
            shape: box,
            size: { x: 0.03 m, y: 0.03 m, z: 0.03 m },
            mass: 0.01,
            friction: { slide: 0.8, torsion: 0.01, roll: 0.0001 }
        }
    }
}

CONTEXT (ns=app) shared {
    world: World {
        cube:             SceneObject,
        table:            SceneObject,
        half-arm-2-link:  Link,
        gravity:          Gravity,
        pose-ee-base:     Pose { of: g_pinch, wrt: base_link, as-seen-by: base_link },
        twist-ee-base:    VelocityTwist { of: g_pinch, wrt: base_link, as-seen-by: base_link },
        pose-cube-base:   Pose { of: cube, wrt: base_link, as-seen-by: base_link },
        pose-elbow-base:  Pose { of: half_arm_2_link, wrt: base_link, as-seen-by: base_link }
    },
    spec: Spec {
        zero-linvel: LinearVelocity = 0.0 m/s,
        zero-dist:   LinearDistance = 0.0 m,
        grasp-roll:  Angle = 3.14159 rad,
        grasp-pitch: Angle = 0.0 rad,
        grasp-yaw:   Angle = 1.5708 rad,
        gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
    }
}

MOTION_SPEC (ns=app) home {
    MOVE: "Hold the TCP at the startup home pose"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            home-pose:  Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <spec.home-pose>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.home-pose>
    }

    UNTIL all {
        at-home-settled: <shared.world.pose-ee-base> equal to <spec.home-pose>
    }
}

MOTION_SPEC (ns=app) pick-above {
    MOVE: "Move TCP to the pre-grasp position above the cube"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            // absolute EE z in robot-base frame = cube_base_z (~0.04) + 0.22m above cube
            above-z:       LinearDistance = 0.26 m,
            alpha:         TrajectoryProgress,
            start-pose:    Pose = Snapshot of <shared.world.pose-ee-base>,
            start-cube-x:  LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.x,
            start-cube-y:  LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.y,
            goal-pose:  Pose {
                position: {
                    x: <spec.start-cube-x>,
                    y: <spec.start-cube-y>,
                    z: <spec.above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            traj: Trajectory = Lerp {
                start: <spec.start-pose>,
                goal:  <spec.goal-pose>,
                alpha: <spec.alpha>
            }
        }
    }

    WHEN {
        lin-x-at-rest: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-at-rest: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-at-rest: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.traj>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.traj>
    }

    UNTIL all {
        at-pick-above-settled: <shared.world.pose-ee-base> equal to <spec.goal-pose>,
        lin-x-settled: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-settled: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-settled: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}

MOTION_SPEC (ns=app) pick {
    MOVE: "Lower TCP to the grasp height at the cube"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            grasp-x:         LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.x,
            grasp-y:         LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.y,
            grasp-z:         LinearDistance = 0.03 m,
            grasp-reach:     LinearDistance = 0.06 m,
            pick-alpha:      TrajectoryProgress,
            pick-start-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            grasp-goal-pose: Pose {
                position: {
                    x: <spec.grasp-x>,
                    y: <spec.grasp-y>,
                    z: <spec.grasp-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            pick-traj: Trajectory = Lerp {
                start: <spec.pick-start-pose>,
                goal:  <spec.grasp-goal-pose>,
                alpha: <spec.pick-alpha>
            }
        }
    }

    WHEN {
        lin-x-at-rest: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-at-rest: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-at-rest: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.pick-traj>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.pick-traj>
    }

    UNTIL all {
        near-cube: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <pick.spec.grasp-reach>
    }
}

MOTION_SPEC (ns=app) grasp-hold {
    MOVE: "Hold TCP at the current base-frame pose while the gripper actuates"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            hold-x:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            hold-y:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            hold-z:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.z,
            support-z: LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z,
            hold-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        hold-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) lift {
    MOVE: "Raise TCP while holding the cube"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            lift-z:          LinearDistance = 0.32 m,
            lift-start-x:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            lift-start-y:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            lift-alpha:      TrajectoryProgress,
            lift-start-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            lift-goal-pose:  Pose {
                position: {
                    x: <spec.lift-start-x>,
                    y: <spec.lift-start-y>,
                    z: <spec.lift-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            lift-traj: Trajectory = Lerp {
                start: <spec.lift-start-pose>,
                goal:  <spec.lift-goal-pose>,
                alpha: <spec.lift-alpha>
            }
        }
    }

    WHEN {}

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.lift-traj>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.lift-traj>
    }

    UNTIL all {
        lin-z-settled: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}


CONSTRAINT_HANDLER (ns=app) handler-home {
    CONTEXT {
        <shared.world>,
        <shared.spec>
    }

    MOTION: <home>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-home-settled: monitor <home.at-home-settled> and trigger event home-settled when active
    }

    CONTROLLERS {
        ctrl-hold-position:    PID { constraint: <home.hold-position>,    Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-hold-orientation: PID { constraint: <home.hold-orientation>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        arm-solver: Solver {
            robot:     <pick-place-env.robot>,
            algorithm: ACHD,
            root:      <pick-place-env.robot.chain.root>,
            end:       <pick-place-env.robot.chain.end>,
            gravity:   <shared.world.gravity> equal to <shared.spec.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-pick-above {
    CONTEXT {}

    MOTION: <pick-above>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-pick-above-settled: monitor <pick-above.at-pick-above-settled> and trigger event pick-above-settled when active
    }

    CONTROLLERS {
        ctrl-pa-follow-pos: PID { constraint: <pick-above.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pa-follow-ori: PID { constraint: <pick-above.follow-ori>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-pick {
    CONTEXT {}

    MOTION: <pick>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-near-cube: monitor <pick.near-cube> and trigger event near-cube when active
    }

    CONTROLLERS {
        ctrl-pk-follow-pos: PID { constraint: <pick.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pk-follow-ori: PID { constraint: <pick.follow-ori>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-close-grip {
    CONTEXT {}

    MOTION: <grasp-hold>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-at-cube: monitor <grasp-hold.hold-x> and trigger event at-grasp when active
    }

    ACTIONS {
        close-gripper: gripper <pick-place-env.gripper-mjcf> close
    }

    CONTROLLERS {
        ctrl-cg-hold-x:      PID { constraint: <grasp-hold.hold-x>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-cg-hold-y:      PID { constraint: <grasp-hold.hold-y>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-cg-hold-z:      PID { constraint: <grasp-hold.hold-z>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-cg-hold-orientation: PID { constraint: <grasp-hold.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-cg-support-z:   Impedance { constraint: <grasp-hold.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-lift {
    CONTEXT {}

    MOTION: <lift>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-lift-settled: monitor <lift.lin-z-settled> and trigger event lift-settled when active
    }

    ACTIONS {
        close-gripper: gripper <pick-place-env.gripper-mjcf> close
    }

    CONTROLLERS {
        ctrl-lt-follow-pos: PID { constraint: <lift.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-lt-follow-ori: PID { constraint: <lift.follow-ori>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

MOTION_SPEC (ns=app) place-above {
    MOVE: "Move TCP laterally to the pre-place position above the place location"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            place-x:           LinearDistance = 0.40 m,
            place-y:           LinearDistance = 0.24 m,
            place-above-z:     LinearDistance = 0.22 m,
            support-z:         LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z,
            place-above-alpha: TrajectoryProgress,
            place-above-start-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            goal-pose-above: Pose {
                position: {
                    x: <spec.place-x>,
                    y: <spec.place-y>,
                    z: <spec.place-above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            place-above-traj: Trajectory = Lerp {
                start: <spec.place-above-start-pose>,
                goal:  <spec.goal-pose-above>,
                alpha: <spec.place-above-alpha>
            }
        }
    }

    WHEN {
        lin-z-at-lift: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        reach-x:    keeping <shared.world.pose-ee-base>.position.x             equal to <spec.place-x>,
        reach-y:    keeping <shared.world.pose-ee-base>.position.y             equal to <spec.place-y>,
        reach-z:    keeping <shared.world.pose-ee-base>.position.z             equal to <spec.place-above-z>,
        align-ori:  keeping <shared.world.pose-ee-base>.orientation            equal to <spec.place-above-traj>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z     equal to <spec.support-z>
    }

    UNTIL all {
        at-place-above-settled: <shared.world.pose-ee-base> equal to <spec.goal-pose-above>,
        lin-x-settled: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-settled: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-settled: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}

MOTION_SPEC (ns=app) place {
    MOVE: "Lower TCP with cube to the place height"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            place-x:           LinearDistance = 0.40 m,
            place-y:           LinearDistance = 0.24 m,
            place-z:           LinearDistance = 0.03 m,
            support-z:         LinearDistance,
            place-alpha:       TrajectoryProgress,
            place-start-pose:  Pose = Snapshot of <shared.world.pose-ee-base>,
            goal-pose-place: Pose {
                position: {
                    x: <spec.place-x>,
                    y: <spec.place-y>,
                    z: <spec.place-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            place-traj: Trajectory = Lerp {
                start: <spec.place-start-pose>,
                goal:  <spec.goal-pose-place>,
                alpha: <spec.place-alpha>
            }
        }
    }

    WHEN {
        lin-x-at-rest: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-at-rest: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-at-rest: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }

    WHILE {
        reach-x:    keeping <shared.world.pose-ee-base>.position.x             equal to <spec.place-x>,
        reach-y:    keeping <shared.world.pose-ee-base>.position.y             equal to <spec.place-y>,
        reach-z:    keeping <shared.world.pose-ee-base>.position.z             equal to <spec.place-z>,
        align-ori:  keeping <shared.world.pose-ee-base>.orientation            equal to <spec.place-traj>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z     equal to <spec.support-z>
    }

    UNTIL all {
        at-place-settled: <shared.world.pose-ee-base> equal to <spec.goal-pose-place>,
        lin-x-settled: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-settled: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-settled: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}

MOTION_SPEC (ns=app) open-grasp-hold {
    MOVE: "Hold TCP at place pose while gripper opens"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            hold-x:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            hold-y:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            hold-z:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.z,
            support-z: LinearDistance,
            hold-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-x: keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y: keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        hold-z: keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler-place-above {
    CONTEXT {}

    MOTION: <place-above>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-place-above-settled: monitor <place-above.at-place-above-settled> and trigger event place-above-settled when active
    }

    ACTIONS {
        close-gripper: gripper <pick-place-env.gripper-mjcf> close
    }

    CONTROLLERS {
        ctrl-pla-reach-x:     PID { constraint: <place-above.reach-x>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pla-reach-y:     PID { constraint: <place-above.reach-y>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pla-reach-z:     PID { constraint: <place-above.reach-z>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pla-align-ori:   PID { constraint: <place-above.align-ori>,   Kp = 120, Ki = 50,  Kd = 80, decay = 0 },
        ctrl-pla-support-z:   Impedance { constraint: <place-above.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-place {
    CONTEXT {}

    MOTION: <place>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-place-settled: monitor <place.at-place-settled> and trigger event place-settled when active
    }

    ACTIONS {
        close-gripper: gripper <pick-place-env.gripper-mjcf> close
    }

    CONTROLLERS {
        ctrl-pl-reach-x:     PID { constraint: <place.reach-x>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pl-reach-y:     PID { constraint: <place.reach-y>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pl-reach-z:     PID { constraint: <place.reach-z>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pl-align-ori:   PID { constraint: <place.align-ori>,   Kp = 120, Ki = 50,  Kd = 80, decay = 0 },
        ctrl-pl-support-z:   Impedance { constraint: <place.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}


CONSTRAINT_HANDLER (ns=app) handler-open-grip {
    CONTEXT {}

    MOTION: <open-grasp-hold>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-open-at-cube: monitor <open-grasp-hold.hold-x> and trigger event at-open-grasp when active
    }

    ACTIONS {
        open-gripper: gripper <pick-place-env.gripper-mjcf> open
    }

    CONTROLLERS {
        ctrl-og-hold-x:      PID { constraint: <open-grasp-hold.hold-x>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-og-hold-y:      PID { constraint: <open-grasp-hold.hold-y>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-og-hold-z:      PID { constraint: <open-grasp-hold.hold-z>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-og-hold-orientation: PID { constraint: <open-grasp-hold.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-og-support-z:   Impedance { constraint: <open-grasp-hold.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

MOTION_SPEC (ns=app) retreat {
    MOVE: "Move TCP upward to the pre-grasp height above the place location"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            place-x:           LinearDistance = 0.40 m,
            place-y:           LinearDistance = 0.24 m,
            place-above-z:     LinearDistance = 0.22 m,
            support-z:         LinearDistance,
            retreat-alpha:     TrajectoryProgress,
            retreat-start-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            goal-pose-retreat: Pose {
                position: {
                    x: <spec.place-x>,
                    y: <spec.place-y>,
                    z: <spec.place-above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            retreat-traj: Trajectory = Lerp {
                start: <spec.retreat-start-pose>,
                goal:  <spec.goal-pose-retreat>,
                alpha: <spec.retreat-alpha>
            }
        }
    }

    WHEN {}

    WHILE {
        reach-x:    keeping <shared.world.pose-ee-base>.position.x             equal to <spec.place-x>,
        reach-y:    keeping <shared.world.pose-ee-base>.position.y             equal to <spec.place-y>,
        reach-z:    keeping <shared.world.pose-ee-base>.position.z             equal to <spec.place-above-z>,
        align-ori:  keeping <shared.world.pose-ee-base>.orientation            equal to <spec.retreat-traj>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z     equal to <spec.support-z>
    }

    UNTIL all {
        at-retreat-settled: <shared.world.pose-ee-base> equal to <spec.goal-pose-retreat>,
        lin-x-settled: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel>,
        lin-y-settled: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel>,
        lin-z-settled: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-retreat {
    CONTEXT {}

    MOTION: <retreat>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-retreat-settled: monitor <retreat.at-retreat-settled> and trigger event retreat-settled when active
    }

    ACTIONS {
        open-gripper: gripper <pick-place-env.gripper-mjcf> open
    }

    CONTROLLERS {
        ctrl-ret-reach-x:     PID { constraint: <retreat.reach-x>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-ret-reach-y:     PID { constraint: <retreat.reach-y>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-ret-reach-z:     PID { constraint: <retreat.reach-z>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-ret-align-ori:   PID { constraint: <retreat.align-ori>,   Kp = 120, Ki = 50,  Kd = 80, decay = 0 },
        ctrl-ret-support-z:   Impedance { constraint: <retreat.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

