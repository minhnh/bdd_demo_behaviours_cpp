ns collab-scn='https://secorolab.github.io/models/demos/collab/scene/'

obj set (ns=collab-scn) collab-objects {
    object drawer,
    object marker-0,
    object marker-10
}

obj set (ns=collab-scn) ws-objects {
    object rk-table,
    object table-robot
}

ws set (ns=collab-scn) collab-workspaces {
    workspace wall-ws,
    workspace robot-ws
}

agn set (ns=collab-scn) collab-agents {
    agent kinova,
    agent gripper
}

comp (ns=collab-scn) wall-cmp of ws <collab-workspaces.wall-ws> {obj <ws-objects.rk-table>}
comp (ns=collab-scn) robot-cmp of ws <collab-workspaces.robot-ws> {obj <ws-objects.table-robot>}

scene (ns=collab-scn) collab-scene {
    obj set <collab-objects>
    agn set <collab-agents>
    ws comp <wall-cmp>
    ws comp <robot-cmp>
}
