import "collab.bdd"
import "collab.scenex"

bhv impl (ns=collab-bdd) collab-bhv-server {
    bhv action: "/bdd/collab_bhv_server"
}

obs provider (ns=collab-bdd) obj-recog-topic {
    ros topic: "/recognized_objects" type: "vision_msgs/msg/Detection3DArray"
}

obs provider (ns=collab-bdd) ee-wrench-topic {
    ros topic: "/ee_wrench" type: "geometry_msgs/msg/WrenchStamped"
}

obs policy (ns=collab-bdd) container-at-pick-ws
    for <transport-tmpl.container-in-scene> horizon: 2.0 seconds
{
    observation container-pose {
        provider: <obj-recog-topic> observes var <transport-tmpl.container>
    }
    observation pick-ws-pose {
        provider: <obj-recog-topic> observes var <transport-tmpl.pick-ws>
    }
    time extractor: py { module: bdd_exec_ros2.observation, attr: header_stamp }
    entity mapper: py { module: bdd_exec_ros2.observation, attr: map_detection3d_array_by_uri }
    evaluator: linear distance { less-than: 0.30 m }
}

obs policy (ns=collab-bdd) container-at-place-ws
    for <transport-tmpl.container-at-dest> horizon: 2.0 seconds
{
    observation container-pose {
        provider: <obj-recog-topic> observes var <transport-tmpl.container>
    }
    observation pick-ws-pose {
        provider: <obj-recog-topic> observes var <transport-tmpl.place-ws>
    }
    time extractor: py { module: bdd_exec_ros2.observation, attr: header_stamp }
    entity mapper: py { module: bdd_exec_ros2.observation, attr: map_detection3d_array_by_uri }
    evaluator: linear distance { less-than: 0.30 m }
}

obs policy (ns=collab-bdd) container-not-dropped-trin
    for <transport-tmpl.container-not-dropped>
{ trinary topic: "/obs_policy/container-not-dropped" }

obs policy (ns=collab-bdd) compliant-ee-wrench
    for <compliant-transport.robot-compliant>
{
    observation ee-wrench-obs { provider: <ee-wrench-topic> }
    time extractor: py { module: bdd_exec_ros2.observation, attr: header_stamp }
    evaluator: py { module: bdd_exec_ros2.observation, attr: WrenchForceNormWithinLimitEvaluator }
}

Scenario Exec (ns=collab-bdd) collab-transport-exec{
    variant: <collab-transport-us.compliant-transport>
    scene inst: <collab-scene-simreal>
    bhv: <collab-bhv-server>
    policies: {
        <container-at-pick-ws>,
        <container-at-place-ws>,
        <compliant-ee-wrench>,
        <container-not-dropped-trin>
    }
}
