import "collab.scene"
import "../robots/kinova-ft-2f85.ktree"

scene inst (ns=collab) collab-scene-simreal {
    scene: <collab-scn>
    kgraph (ns=collab) collab-kgraph {
        tree <kinova-ft-2f85>

        body world {
            frame root {}
            frame ground {
                pose ground_in_world {
                    wrt: <world.root>
                    xyz: (0.0, 0.0, -0.72) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }

        body robot-table-body {
            frame table_top {
                pose in-world {
                    wrt: <world.root> xyz: (0.295, 0.725, 0.0) m
                    orientation: euler {angles: (90.0, 0.0, 0.0) unit: deg}
                }
            }
            frame arm-mount {
                pose wrt-table-top {
                    wrt: <world.root> xyz: (0.0, 0.7, 0.0) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame table-com {
                pose com-in-table-top {
                    wrt: <robot-table-body.table_top> xyz: (0.0, 0.0, -0.1075) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            // The asset states no mass, so it is estimated from its geometry: a 1.6 x 0.8 x 0.04 m
            // top at 30 kg on four 0.7 m legs at 2.5 kg each, about the centre of mass that puts
            // 0.1075 m below the top surface. The table is fixed to the world, so no solver moves
            // it -- these carry the tree, not the dynamics.
            inertia {
                frame: <table-com>
                mass: 40.0 kg
                inertia-matrix: (
                    (4.302, 0.0, 0.0),
                    (0.0, 13.662, 0.0),
                    (0.0, 0.0, 15.303)
                ) kg*m^2
            }
        }

        joints {
            fixed table_on_world {
   parent: <world.root>
   child: <robot-table-body.table_top>
}
            fixed arm_on_table {
                parent: <robot-table-body.table_top>
                child: <kinova.base_link.base_link_origin>
            }
        }
    }

    obj <ws-objects.table-robot> {
        model robot-table-mjc as mjcf {
            sys path = '../../assets/table.xml'
            map body <collab-kgraph.robot-table-body> to "robot_table"
        }
    }

    agn <collab-agents.kinova> {
        model kinova-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml'
            map tree <kinova> to "base_link"
        }

        model ft-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/ft_sensor.xml'
            map tree <ft_tree> to "wrist_ft_body"
        }

        force-torque wrist_ft {
            frame: <ft_tree.wrist_ft_body.wrist_ft_site>
            observes: force torque
            update-rate: 1000.0 Hz
        }

        camera wrist {
            frame: <kinova.bracelet_link.wrist_anchor>
            type: rgb
            resolution: (640, 480)
            fov: 41.83792730009236 deg
            update-rate: 30.0 Hz
        }
    }

    agn <collab-agents.gripper> {
        model gripper-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
            map tree <gripper> to "base_mount"
        }
    }
}
