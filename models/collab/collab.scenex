import "collab.scene"
import "../robots/kinova-ft-2f85.ktree"

// Per-trial draws: place point (z band is a hairline, a uniform needs an interval), push gate, hold.
distrib (ns=collab-scn) place-xy {
    uniform {
        dimension: 3
        lower: (0.674, -0.40, 0.050)
        upper: (0.824, 0.40, 0.051)
    }
}
distrib (ns=collab-scn) push-gate-y {
    uniform { dimension: 1 lower: (-0.30) upper: (-0.15) }
}
distrib (ns=collab-scn) push-hold-secs {
    uniform { dimension: 1 lower: (0.3) upper: (0.6) }
}

scene inst (ns=collab-scn) collab-scene-simreal {
    scene: <collab-scene>
    kgraph (ns=collab-scn) collab-kgraph {
        anchor: <world.root>
        tree <kinova-ft-2f85>

        body world {
            // What the scene stands on: the floor is here, and every placement resolves
            // into this frame. Named for MuJoCo, whose compiler matches on "world".
            frame root {}
        }

        body robot-table-body {
            // The body's root frame, so the asset's own origin: the centre of the table top,
            // which is what the MJCF places and what its site is named after.
            frame table_top {
                pose top_on_anchor {
                    wrt: <robot-table-body.table_anchor> xyz: (0.295, 0.725, 0.0) m
                    orientation: euler {angles: (90.0, 0.0, 0.0) unit: deg}
                }
            }
            // The corner the table is anchored by, above the world origin at table height.
            frame table_anchor {
                pose in-world {
                    wrt: <world.root> xyz: (0.0, 0.0, 0.72) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame arm-mount {
                pose wrt-table-top {
                    wrt: <table_top> xyz: (0.7, 0.0, 0.0) m
                    orientation: euler {angles: (-180.0, 0.0, 0.0) unit: deg}
                }
            }
            frame place_spot {
                pose spot_on_mount {
                    wrt: <robot-table-body.arm-mount> xyz: sample <place-xy> m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame table-com {
                pose com-in-table-top {
                    wrt: <robot-table-body.table_top> xyz: (0.0, 0.0, -0.1075) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame perception_view {
                pose view_on_table {
                    wrt: <robot-table-body.table_anchor>
                    xyz: (0.295, -1.30, 0.88) m
                    orientation: direction-cosine {
                        x: (1.0, 0.0, 0.0)
                        y: (0.0, 0.287347885566, -0.957826285221)
                        z: (0.0, 0.957826285221, 0.287347885566)
                    }
                }
            }
            // The asset states no mass, so it is estimated from its geometry: a 1.6 x 0.8 x 0.04 m
            // top at 30 kg on four 0.7 m legs at 2.5 kg each, about the centre of mass that puts
            // 0.1075 m below the top surface. The table is fixed to the world, so no solver moves
            // it -- these carry the tree, not the dynamics.
            inertia {
                frame: <table-com>
                mass: 40.0 kg
                inertia-matrix: (
                    (4.302, 0.0, 0.0),
                    (0.0, 13.662, 0.0),
                    (0.0, 0.0, 15.303)
                ) kg*m^2
            }
        }

        body rk-table-body {
            frame leg_center {
                pose in-world {
                    wrt: <world.root> xyz: (-0.75, 1.87, 0.02) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            // The height the tray stands at, measured from this table's own origin.
            frame work_surface {
                pose surface_on_rk_table {
                    wrt: <rk-table-body.leg_center> xyz: (0.0, 0.0, 0.75) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame table-com {
                pose com-in-table-top {
                    wrt: <rk-table-body.leg_center> xyz: (-0.0815, 0.0999, 0.7034) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame rk_anchor {
                pose anchor_on_rk {
                    wrt: <rk-table-body.work_surface>
                    xyz: (0.65, -0.275, 0.0) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame spectator_view {
                pose view_on_rk {
                    wrt: <world.root>
                    xyz: (1.394, -0.656, 1.800) m
                    orientation: direction-cosine {
                        x: (0.819295746960, -0.286721691783, 0.496533131295)
                        y: (0.573371152931, 0.409699479017, -0.709501133107)
                        z: (0.0, 0.865989034777, 0.500062987679)
                    }
                }
            }
            // Rear sensor at 33 deg elevation: the flattest look that still resolves a 0.05 m wall marker.
            frame rk_view {
                pose view_on_world {
                    wrt: <world.root>
                    xyz: (0.80, 1.90, 1.80) m
                    orientation: direction-cosine {
                        x: (-0.020640762978, -0.545740028629, 0.837700292500)
                        y: (0.999786956758, -0.011266890914, 0.017294457652)
                        z: (0.0, 0.837878796916, 0.545856319629)
                    }
                }
            }

            // Estimated from the STEP solids: two 15 kg lift columns, a 13.65 kg top, a 25 kg
            // cabinet, and aluminium density for the modelled profiles, gantry, rails and fittings.
            // ponytail: replace with measured mass properties if this table becomes dynamic; the
            // current estimate is intended for a stationary workstation.
            inertia {
                frame: <table-com>
                mass: 111.45 kg
                inertia-matrix: (
                    (19.026, -1.350, -2.245),
                    (-1.350, 40.606, -3.692),
                    (-2.245, -3.692, 31.393)
                ) kg*m^2
            }
        }

        body drawer-body {
            frame drawer-root {
                pose on-rk-table {
                    wrt: <rk-table-body.work_surface> xyz: (0.15, 0.0, 0.0) m
                    orientation: euler {angles: (90.0, 0.0, 0.0) unit: deg}
                }
            }
            frame drawer-com {
                pose com-in-drawer {
                    wrt: <drawer-body.drawer-root> xyz: (0.000025, -0.023302, 0.028773) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            frame drawer-handle {
                pose handle-in-drawer {
                    wrt: <drawer-body.drawer-root> xyz: (0.0, -0.12, 0.04) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            // COM is derived from the exact hollow meshes in tray.xml; inertia is calibrated to
            // the measured 350 g printed mass (an effective mesh density of 1046.7 kg/m^3).
            // ponytail: regenerate if the print geometry or measured mass changes.
            inertia {
                frame: <drawer-com>
                mass: 0.350 kg
                inertia-matrix: (
                    (0.002839864, 0.000000373, 0.000000416),
                    (0.000000373, 0.002233384, 0.000103658),
                    (0.000000416, 0.000103658, 0.004655829)
                ) kg*m^2
            }
        }

        body marker0-body {
            // world_pose_node anchors its ref_frame on this frame.
            frame marker0_origin {
                pose on-table-anchor {
                    wrt: <robot-table-body.table_anchor> xyz: (-0.0383333, -0.0083333, 0.0) m
                    orientation: euler {angles: (0.0, 0.0, 0.0) unit: deg}
                }
            }
            inertia {
                frame: <marker0_origin>
                mass: 0.010 kg
                inertia-matrix: (
                    (0.0000148, 0.0, 0.0),
                    (0.0, 0.0000148, 0.0),
                    (0.0, 0.0, 0.0000296)
                ) kg*m^2
            }
        }

        body marker10-body {
            // Not rk_anchor: there the sheet would hang over two edges. Yawed as the printed one is.
            frame marker10_origin {
                pose on-work-surface {
                    wrt: <rk-table-body.work_surface> xyz: (0.6333333, -0.2583333, 0.0) m
                    orientation: euler {angles: (90.0, 0.0, 0.0) unit: deg}
                }
            }
            inertia {
                frame: <marker10_origin>
                mass: 0.010 kg
                inertia-matrix: (
                    (0.0000148, 0.0, 0.0),
                    (0.0, 0.0000148, 0.0),
                    (0.0, 0.0, 0.0000296)
                ) kg*m^2
            }
        }


        joints {
            fixed table_on_world {
                parent: <world.root>
                child: <robot-table-body.table_anchor>
            }
            fixed rk_table_on_world {
                parent: <world.root>
                child: <rk-table-body.leg_center>
            }
            fixed arm_on_table {
                parent: <robot-table-body.arm-mount>
                child: <kinova.base_link.base_link_origin>
            }
            // Welded to the world like the tables: a weld onto another object's root names a site the scene never builds.
            fixed marker0_on_world {
                parent: <world.root>
                child: <marker0-body.marker0_origin>
            }
            fixed marker10_on_world {
                parent: <world.root>
                child: <marker10-body.marker10_origin>
            }
        }
    }

    obj <ws-objects.table-robot> {
        model robot-table-mjc as mjcf {
            ros pkg="bdd_collab_bhv_cpp", path= 'assets/table.xml'
            map body <collab-kgraph.robot-table-body> to "robot_table"
        }
    }

    obj <ws-objects.rk-table> {
        model robot-table-mjc as mjcf {
            ros pkg="bdd_collab_bhv_cpp", path= 'assets/rk-table/rk-table.xml'
            map body <collab-kgraph.rk-table-body> to "rk_table"
        }
    }

    obj <collab-objects.drawer> {
        model tray-mjc as mjcf {
            ros pkg="bdd_collab_bhv_cpp", path= 'assets/tray/tray_markers.xml'
            map body <collab-kgraph.drawer-body> to "drawer"
        }
    }

    obj <collab-objects.marker-0> {
        model marker0-mjc as mjcf {
            ros pkg="bdd_collab_bhv_cpp", path= 'assets/markers/marker_0.xml'
            map body <collab-kgraph.marker0-body> to "root"
        }
    }

    obj <collab-objects.marker-10> {
        model marker10-mjc as mjcf {
            ros pkg="bdd_collab_bhv_cpp", path= 'assets/markers/marker_10.xml'
            map body <collab-kgraph.marker10-body> to "root"
        }
    }

    agn <collab-agents.kinova> {
        model kinova-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml'
            map tree <kinova> to "base_link"
        }

        model ft-mjc as mjcf {
            sys path = 'src/bdd_collab_bhv_cpp/assets/ft_mount.xml'
            map tree <ft_tree> to "wrist_ft_body"
        }

        force-torque wrist_ft {
            frame: <ft_tree.wrist_ft_body.wrist_ft_site>
            observes: force torque
            update-rate: 100.0 Hz
        }

        camera wrist {
            frame: <kinova.bracelet_link.wrist_anchor>
            type: rgb
            resolution: (640, 480)
            fov: 41.83792730009236 deg
            update-rate: 30.0 Hz
        }

        // Only an agent block may hold a sensor; the frame on the fixed table makes it a static camera.
        camera spectator {
            frame: <collab-kgraph.rk-table-body.spectator_view>
            type: rgb
            resolution: (1280, 720)
            fov: 60.0 deg
            update-rate: 30.0 Hz
        }

        camera perception {
            frame: <collab-kgraph.robot-table-body.perception_view>
            type: rgb
            resolution: (1920, 1080)
            fov: 45.0 deg
            update-rate: 30.0 Hz
        }

        camera rk {
            frame: <collab-kgraph.rk-table-body.rk_view>
            type: rgb
            resolution: (1920, 1080)
            fov: 40.0 deg
            update-rate: 30.0 Hz
        }
    }

    agn <collab-agents.gripper> {
        model gripper-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
            map tree <gripper> to "base_mount"
        }
    }
}
