ns collab-coord='https://secorolab.github.io/models/demos/collab/coordination/'

evt loop (ns=collab-coord) sim_demo_hold_fsm_events {
    evt E_STEP,
    evt E_GOAL,
    evt E_OBJ_LOCATED,
    evt E_TABLE_TOUCHED,
    evt E_OBJ_REACHED,
    evt E_OBJ_GRASPED,
    // Exported events
    evt E_PICK_START,
    evt E_PICK_END,
    evt E_PLACE_START,
    evt E_PLACE_END
}

fsm (ns=collab-coord) sim_demo_hold_fsm {
    description: "Hold the pose the arm started in while the gripper cycles. The run holds that pose in S_WAIT until a goal arrives, so the cycle starts when a scenario asks for it rather than at startup."

    states {
        S_START,
        S_WAIT,
        S_LOOK,
        S_TOUCH,
        S_SLIDE,
        S_CLOSE,
        S_DONE
    }

    evt loop: <sim_demo_hold_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_WAIT  { from: <S_START>, to: <S_WAIT> },
        T_WAIT_LOOK  { from: <S_WAIT>,  to: <S_LOOK> },
        T_LOOK_TOUCH  { from: <S_LOOK>, to: <S_TOUCH> },
        T_TOUCH_SLIDE  { from: <S_TOUCH>, to: <S_SLIDE> },
        T_SLIDE_CLOSE  { from: <S_SLIDE>,  to: <S_CLOSE> },
        T_CLOSE_WAIT  { from: <S_CLOSE>,  to: <S_WAIT> }
    }

    reactions {
        R_STEP_START {
            when: <sim_demo_hold_fsm_events.E_STEP>, do: <T_START_WAIT>
        },
        R_GOAL {
            when: <sim_demo_hold_fsm_events.E_GOAL>, do: <T_WAIT_LOOK>
        },
        R_OBJ_LOCATED {
            when: <sim_demo_hold_fsm_events.E_OBJ_LOCATED>, do: <T_LOOK_TOUCH>,
            fires { <sim_demo_hold_fsm_events.E_PICK_START> }
        },
        R_TABLE_TOUCHED {
            when: <sim_demo_hold_fsm_events.E_TABLE_TOUCHED>, do: <T_TOUCH_SLIDE>
        },
        R_OBJ_REACHED {
            when: <sim_demo_hold_fsm_events.E_OBJ_REACHED>, do: <T_SLIDE_CLOSE>
        },
        R_OBJ_GRASPED {
            when: <sim_demo_hold_fsm_events.E_OBJ_GRASPED>, do: <T_CLOSE_WAIT>,
            fires { <sim_demo_hold_fsm_events.E_PICK_END> }
        }
    }
}
