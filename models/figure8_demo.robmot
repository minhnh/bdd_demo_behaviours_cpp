// Demo: end-effector traces a Figure8 (lemniscate) trajectory in the robot-base frame.
//
// Uses the same Kinova/MuJoCo environment as circle_demo.robmot. The figure-8's
// center, plane-normal, and orientation are all derived from a snapshot of the
// initial EE pose (so the EE traces the curve around its starting position, in a
// plane whose normal is the unit-length starting position vector). The follow-pos
// constraint drives the EE to track the trajectory's position component while the
// orientation is held fixed at the snapshot.
//
// Switch `form: Gerono` to `form: Bernoulli` below to demo the classic infinity
// (∞) shaped curve instead of the Gerono figure-8.

ns app = "https://secorolab.github.io/models/figure8-demo/"

ENVIRONMENT (ns=app) figure8-env {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset {
            model: KinovaGen3,
            xml: "src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml"
        },
        gripper-mjcf: AttachmentAsset {
            xml: "src/mj_kdl_wrapper/third_party/menagerie/robotiq_2f85/2f85.xml"
        },
        table-mjcf: SceneObject {
            xml: "src/mj_kdl_wrapper/src/examples/assets/table.xml"
        }
    },
    ASSEMBLY {
        Object table using <table-mjcf> {
            position: { z: 0.72 m },
            orientation: {}
        },
        Robot robot using <kinova-mjcf> {
            attach-to: <table>.site(table_top),
            position: {},
            orientation: {},
            chain: { root: base_link, end: g_pinch }
        },
        Attachment gripper using <gripper-mjcf> {
            attach-to: <robot>.site(pinch_site),
            prefix: g_,
            tcp-site: g_pinch,
            actuator: g_fingers_actuator
        }
    },
    TRACE {
        enabled: true,
        length: 6144,
        color: { r: 1.0, g: 0.5, b: 0.1, a: 1.0 }
    }
}

CONTEXT (ns=app) shared {
    world: World {
        gravity:      Gravity,
        pose-ee-base: Pose { of: g_pinch, wrt: base_link, as-seen-by: base_link }
    },
    spec: Spec {
        gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
    }
}

MOTION_SPEC (ns=app) m_figure8 {
    MOVE: "EE traces a figure-8 around its starting position"

    CONTEXT {
        <shared.world>,
        <shared.spec>,
        spec: Spec {
            alpha:        TrajectoryProgress,
            radius:       LinearDistance = 0.10 m,
            plane-normal: Direction { as-seen-by: base_link } { x = 1.0, y = 0.0, z = 0.0 },
            start-pose:   Pose = Snapshot of <shared.world.pose-ee-base>,
            traj: Trajectory = Figure8 {
                anchor:       <spec.start-pose>,
                radius:       <spec.radius>,
                plane-normal: <spec.plane-normal>,
                alpha:        <spec.alpha>,
                form:         Gerono
            }
        }
    }

    WHEN {}

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.traj>.position,
        hold-ori:   keeping <shared.world.pose-ee-base>.orientation equal to <spec.start-pose>.orientation
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler-figure8 {
    CONTEXT {
        <shared.world>,
        <shared.spec>
    }

    MOTION: <m_figure8>
    CONTROL_MODE: JointTorque

    CONTROLLERS {
        ctrl-follow-pos: PID { constraint: <m_figure8.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-hold-ori:   PID { constraint: <m_figure8.hold-ori>,   Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        arm-solver: Solver {
            robot:     <figure8-env.robot>,
            algorithm: ACHD,
            root:      <figure8-env.robot.chain.root>,
            end:       <figure8-env.robot.chain.end>,
            gravity:   <shared.world.gravity> equal to <shared.spec.gravity-vec>
        }
    }
}
