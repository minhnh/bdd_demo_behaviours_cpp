ns app = "https://secorolab.github.io/models/mj-fall/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset {
            model: KinovaGen3,
            xml: "src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml"
        }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: base_link, end: bracelet_link }
        }
    }
}

MOTION_SPEC (ns=app) fall-down {
    MOVE: "Move the Kinova Gen3 end effector downward at constant world-z velocity"

    CONTEXT {
        world: World {
            pose-ee: Pose {
                of: bracelet_link,
                wrt: base_link,
                as-seen-by: base_link
            },
            twist-ee: VelocityTwist {
                of: bracelet_link,
                wrt: base_link,
                as-seen-by: base_link
            }
        },
        spec: Spec {
            vel-x-zero: LinearVelocity = 0.0 m/s,
            vel-y-zero: LinearVelocity = 0.0 m/s,
            vel-z-down: LinearVelocity = -0.01 m/s,
            pose-ee-start: Pose = Snapshot of <world.pose-ee>
        }
    }

    WHEN {}

    WHILE {
        cstr-linvel-x: keeping <world.twist-ee>.linvel.x equal to <spec.vel-x-zero>,
        cstr-linvel-y: keeping <world.twist-ee>.linvel.y equal to <spec.vel-y-zero>,
        cstr-linvel-z: keeping <world.twist-ee>.linvel.z equal to <spec.vel-z-down>,
        cstr-orientation: keeping <world.pose-ee>.orientation equal to <spec.pose-ee-start>.orientation
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler-fall-down {
    CONTEXT {
        world: World {
            gravity: Gravity
        },
        spec: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <fall-down>
    CONTROL_MODE: JointTorque

    MONITORS {}

    CONTROLLERS {
        ctrl-linvel-x: PID { constraint: <fall-down.cstr-linvel-x>, Kp = 10, Ki = 0, Kd = 0},
        ctrl-linvel-y: PID { constraint: <fall-down.cstr-linvel-y>, Kp = 10, Ki = 0, Kd = 0},
        ctrl-linvel-z: PID { constraint: <fall-down.cstr-linvel-z>, Kp = 10, Ki = 0, Kd = 0},
        ctrl-orientation: PID { constraint: <fall-down.cstr-orientation>, Kp = 10, Ki = 0, Kd = 6}
    }

    SOLVERS {
        arm-solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <world.gravity> equal to <spec.gravity-vec>
        }
    }
}
