      <geom name="aruco_1" type="box" size="0.0400000 0.0400000 0.0005" pos="0.0650000 -0.1005000 0.0400000" quat="0.707106781 0.707106781 0.000000000 0.000000000" material="aruco_1_mat" mass="0.001" contype="0" conaffinity="0" />
