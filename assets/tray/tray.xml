<mujoco model="tray">
  <!--
    Open-top printed tray (240 x 200 x 80 mm outer) with a fin handle on the front
    wall, as photographed. Single root body, so it can be added as a SceneObject.
    Standalone view: open tray.xml with python -m mujoco.viewer.

    Measured from the meshes (mm): walls 2.3 (sides/back) / 3.2 (front), floor 2.0,
    wall height 77.1 (sides/back) / 79.9 (front). Handle: 20 thick, 75 out, 40 tall,
    centered on the 3.9 screw hole in the front wall (x=120.0, z=40.0).
  -->
  <compiler meshdir="." angle="radian" autolimits="true"/>
  <default>
    <!-- Meshes are visual only: MuJoCo collides meshes as convex hulls, which would
         fill the tray solid. The box geoms below carry the contacts, the meshes the mass. -->
    <geom density="600" friction="0.5 0.02 0.001" solref="0.005 1" contype="0" conaffinity="0"/>
    <default class="collision">
      <geom type="box" mass="0" group="3" rgba="0 1 0.25 0.35" contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <!-- inertia="exact": the tray is hollow, the convex-hull default would make it ~14x too heavy -->
    <mesh name="tray_body"   file="tray_body.stl"   scale="0.001 0.001 0.001" inertia="exact"/>
    <mesh name="tray_handle" file="tray_handle.stl" scale="0.001 0.001 0.001" inertia="exact"/>
    <material name="tray" rgba="0.42 0.45 0.28 1"/>
  </asset>

  <worldbody>
    <!-- Root origin = tray footprint center on the table surface. Place this asset at z=surface_z. -->
    <body name="root">
      <freejoint name="free"/>
      <geom type="mesh" mesh="tray_body"   material="tray" pos="-0.120 -0.100 0"/>
      <geom type="mesh" mesh="tray_handle" material="tray" pos="-0.128 -0.2623 0.020"/>

      <geom name="floor"      class="collision" pos="0 0 0.001"             size="0.1174 0.100 0.001"/>
      <geom name="wall_left"  class="collision" pos="-0.11625 0 0.03856"    size="0.00115 0.100 0.03856"/>
      <geom name="wall_right" class="collision" pos="0.11625 0 0.03856"     size="0.00115 0.100 0.03856"/>
      <geom name="wall_front" class="collision" pos="0 -0.0984 0.03995"     size="0.120 0.0016 0.03995"/>
      <geom name="wall_back"  class="collision" pos="0 0.0984 0.03856"      size="0.1174 0.0016 0.03856"/>
      <!-- handle fin: square approximation of the round-ended slab -->
      <geom name="handle"     class="collision" pos="0 -0.1343 0.040"       size="0.010 0.0375 0.020"
            friction="1.2 0.05 0.005"/>

      <!-- grasp target: outer half of the fin -->
      <site name="grasp" pos="0 -0.150 0.040" size="0.006" rgba="1 0.2 0.2 0" group="3"/>
    </body>
  </worldbody>
</mujoco>
